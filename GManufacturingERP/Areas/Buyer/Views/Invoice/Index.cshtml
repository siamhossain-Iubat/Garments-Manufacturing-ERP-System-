@model IEnumerable<GManufacturingERP.Models.Entities.Invoice>

@{
    ViewData["Title"] = "My Invoices";
    Layout = "~/Areas/Buyer/Views/Shared/_BuyerLayout.cshtml";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-receipt me-2"></i>
                My Invoices
            </h2>

            <p class="text-muted mb-0">
                View your invoices and make payments.
            </p>
        </div>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @TempData["Error"]
        </div>
    }

    <div class="card shadow-sm border-0">

        <div class="card-body">

            @if (!Model.Any())
            {
                <div class="text-center py-5">

                    <i class="bi bi-receipt"
                       style="font-size: 50px;"></i>

                    <h5 class="mt-3">
                        No invoices found
                    </h5>

                    <p class="text-muted">
                        You don't have any invoices yet.
                    </p>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>

                                <th>
                                    Invoice No
                                </th>

                                <th>
                                    Invoice Date
                                </th>

                                <th>
                                    Product
                                </th>

                                <th>
                                    Grand Total
                                </th>

                                <th>
                                    Paid
                                </th>

                                <th>
                                    Due
                                </th>

                                <th>
                                    Status
                                </th>

                                <th class="text-end">
                                    Action
                                </th>

                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var invoice in Model)
                            {
                                <tr>

                                    <td class="fw-semibold">
                                        @invoice.InvoiceNumber
                                    </td>

                                    <td>
                                        @invoice.InvoiceDate.ToString(
                                        "dd MMM yyyy")
                            </td>

                            <td>
                                @invoice.ProductName
                            </td>

                            <td>
                                ৳ @invoice.GrandTotal.ToString("N2")
                            </td>

                            <td class="text-success">
                                ৳ @invoice.PaidAmount.ToString("N2")
                            </td>

                            <td class="text-danger">
                                ৳ @invoice.DueAmount.ToString("N2")
                            </td>

                            <td>

                                @if (invoice.Status == "Paid")
                                        {
                                            <span class="badge bg-success">
                                                Paid
                                            </span>
                                        }
                                        else if (
                                        invoice.Status ==
                                        "Partially Paid")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Partially Paid
                                            </span>
                                        }
                                        else if (
                                        invoice.Status ==
                                        "Issued")
                                        {
                                            <span class="badge bg-primary">
                                                Issued
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @invoice.Status
                                            </span>
                                        }

                                    </td>

                                    <td class="text-end">

                                        <!-- VIEW -->
                                        <a asp-area="Buyer"
                                           asp-controller="Invoice"
                                           asp-action="Details"
                                           asp-route-id="@invoice.Id"
                                           class="btn btn-sm btn-outline-primary">

                                            <i class="bi bi-eye me-1"></i>
                                            View

                                        </a>

                                        <!-- PAY NOW -->
                                        @if (
                                                                        (invoice.Status == "Issued" ||
                                                                        invoice.Status == "Partially Paid") &&
                                                                        invoice.DueAmount > 0)
                                        {
                                            <a asp-area="Finance"
                                               asp-controller="Payment"
                                               asp-action="Create"
                                               asp-route-invoiceId="@invoice.Id"
                                               class="btn btn-sm btn-success">

                                                <i class="bi bi-credit-card me-1"></i>
                                                Pay Now

                                            </a>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>