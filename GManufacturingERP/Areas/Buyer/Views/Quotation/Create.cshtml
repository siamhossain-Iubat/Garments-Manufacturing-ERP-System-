@model GManufacturingERP.ViewModels.CreateQuotationRequestViewModel

@{
    ViewData["Title"] = "Request Quotation";
    Layout = "~/Areas/Buyer/Views/Shared/_BuyerLayout.cshtml";
}

<div class="page-header">

    <div>

        <small>Buyer Portal</small>

        <h1>Request Quotation</h1>

        <p>
            Submit your product requirements to the sales team.
        </p>

    </div>

    <a asp-area="Buyer"
       asp-controller="Quotation"
       asp-action="Index"
       class="btn btn-outline-primary">

        <i class="bi bi-arrow-left me-1"></i>
        My Quotations

    </a>

</div>


<div class="card dashboard-card">

    <div class="card-header">

        <h5 class="mb-0">

            <i class="bi bi-file-earmark-plus-fill"></i>

            Quotation Request Form

        </h5>

    </div>


    <div class="card-body">

        <form asp-area="Buyer"
              asp-controller="Quotation"
              asp-action="Create"
              method="post">

            @Html.AntiForgeryToken()


            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger">
            </div>


            <div class="row g-4">


                <!-- Product -->
                <div class="col-12">

                    <label asp-for="ProductDescription"
                           class="form-label">

                        Product Description
                        <span class="text-danger">*</span>

                    </label>

                    <textarea asp-for="ProductDescription"
                              class="form-control"
                              rows="4"
                              placeholder="Example: Men's Cotton T-Shirt, 180 GSM, Round Neck"></textarea>

                    <span asp-validation-for="ProductDescription"
                          class="text-danger">
                    </span>

                </div>


                <!-- Quantity -->
                <div class="col-md-6">

                    <label asp-for="Quantity"
                           class="form-label">

                        Quantity
                        <span class="text-danger">*</span>

                    </label>

                    <input asp-for="Quantity"
                           type="number"
                           min="1"
                           class="form-control"
                           placeholder="Enter quantity" />

                    <span asp-validation-for="Quantity"
                          class="text-danger">
                    </span>

                </div>


                <!-- Unit -->
                <div class="col-md-6">

                    <label asp-for="Unit"
                           class="form-label">

                        Unit
                        <span class="text-danger">*</span>

                    </label>

                    <select asp-for="Unit"
                            class="form-select">

                        <option value="Pieces">Pieces</option>
                        <option value="Dozen">Dozen</option>
                        <option value="Set">Set</option>
                        <option value="Kg">Kg</option>
                        <option value="Meter">Meter</option>

                    </select>

                    <span asp-validation-for="Unit"
                          class="text-danger">
                    </span>

                </div>


                <!-- Required Delivery -->
                <div class="col-md-6">

                    <label asp-for="RequiredDeliveryDate"
                           class="form-label">

                        Required Delivery Date

                    </label>

                    <input asp-for="RequiredDeliveryDate"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="RequiredDeliveryDate"
                          class="text-danger">
                    </span>

                </div>


                <!-- Shipping Country -->
                <div class="col-md-6">

                    <label asp-for="ShippingCountry"
                           class="form-label">

                        Shipping Country

                    </label>

                    <input asp-for="ShippingCountry"
                           class="form-control"
                           placeholder="Example: Bangladesh" />

                    <span asp-validation-for="ShippingCountry"
                          class="text-danger">
                    </span>

                </div>


                <!-- Shipping Address -->
                <div class="col-12">

                    <label asp-for="ShippingAddress"
                           class="form-label">

                        Shipping Address

                    </label>

                    <textarea asp-for="ShippingAddress"
                              class="form-control"
                              rows="3"
                              placeholder="Enter delivery/shipping address"></textarea>

                    <span asp-validation-for="ShippingAddress"
                          class="text-danger">
                    </span>

                </div>


                <!-- Remarks -->
                <div class="col-12">

                    <label asp-for="Remarks"
                           class="form-label">

                        Remarks / Special Requirements

                    </label>

                    <textarea asp-for="Remarks"
                              class="form-control"
                              rows="4"
                              placeholder="Enter any special requirements, fabric details, color, size, packaging etc."></textarea>

                    <span asp-validation-for="Remarks"
                          class="text-danger">
                    </span>

                </div>


            </div>


            <hr class="my-4" />


            <div class="d-flex justify-content-end gap-2">

                <a asp-area="Buyer"
                   asp-controller="Quotation"
                   asp-action="Index"
                   class="btn btn-outline-secondary">

                    <i class="bi bi-x-circle me-1"></i>
                    Cancel

                </a>


                <button type="submit"
                        class="btn btn-primary">

                    <i class="bi bi-send-fill me-1"></i>
                    Submit Quotation Request

                </button>

            </div>


        </form>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}