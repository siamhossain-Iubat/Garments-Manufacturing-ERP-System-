@model GManufacturingERP.Models.Entities.ApplicationUser

@{
    ViewData["Title"] = "Buyer Dashboard";
    Layout = "~/Areas/Buyer/Views/Shared/_BuyerLayout.cshtml";
}

<div class="page-header">

    <div>

        <small>Buyer Portal</small>

        <h1>Welcome, @Model.FullName</h1>

        <p>
            Manage your company information, quotations and sales activities.
        </p>

    </div>

    <div class="dashboard-date">

        <i class="bi bi-calendar3"></i>

        @DateTime.Now.ToString("dd MMM yyyy")

    </div>

</div>


<!-- Welcome Card -->

<div class="card dashboard-card mb-4">

    <div class="card-body">

        <div class="d-flex align-items-center gap-3">

            <div class="summary-icon blue">

                <i class="bi bi-building"></i>

            </div>

            <div>

                <h4 class="mb-1">
                    @Model.CompanyName
                </h4>

                <p class="text-muted mb-0">
                    @Model.Email
                </p>

            </div>

        </div>

    </div>

</div>


<!-- Account Summary -->

<div class="row g-4 mb-4">


    <!-- Company -->

    <div class="col-lg-4 col-md-6">

        <div class="summary-card">

            <div class="summary-icon blue">

                <i class="bi bi-building"></i>

            </div>

            <div class="summary-content">

                <span>Company</span>

                <h5>
                    @Model.CompanyName
                </h5>

                <small>
                    Registered company
                </small>

            </div>

        </div>

    </div>


    <!-- Account Status -->

    <div class="col-lg-4 col-md-6">

        <div class="summary-card">

            <div class="summary-icon green">

                <i class="bi bi-person-check-fill"></i>

            </div>

            <div class="summary-content">

                <span>Account Status</span>

                @if (Model.AccountStatus == "Approved")
                {
                    <h5 class="text-success">
                        Approved
                    </h5>

                    <small>
                        Account is active
                    </small>
                }
                else
                {
                    <h5 class="text-warning">
                        Pending
                    </h5>

                    <small>
                        Waiting for approval
                    </small>
                }

            </div>

        </div>

    </div>


    <!-- Email Verification -->

    <div class="col-lg-4 col-md-6">

        <div class="summary-card">

            <div class="summary-icon yellow">

                <i class="bi bi-envelope-check-fill"></i>

            </div>

            <div class="summary-content">

                <span>Email Verification</span>

                @if (Model.EmailConfirmed)
                {
                    <h5 class="text-success">
                        Verified
                    </h5>

                    <small>
                        Email verified successfully
                    </small>
                }
                else
                {
                    <h5 class="text-danger">
                        Not Verified
                    </h5>

                    <small>
                        Email verification required
                    </small>
                }

            </div>

        </div>

    </div>

</div>


<!-- Main Sections -->

<div class="row g-4">


    <!-- Company Profile -->

    <div class="col-lg-3 col-md-6">

        <div class="card dashboard-card h-100">

            <div class="card-header">

                <h5 class="mb-0">

                    <i class="bi bi-person-vcard"></i>

                    Company Profile

                </h5>

            </div>


            <div class="card-body">

                <div class="module-placeholder">

                    <i class="bi bi-building"></i>

                    <div>

                        <h6>
                            Company Information
                        </h6>

                        <p>
                            View your company name, contact person,
                            email, phone number and address.
                        </p>

                    </div>

                </div>


                <a asp-area="Buyer"
                   asp-controller="Profile"
                   asp-action="Index"
                   class="btn btn-outline-primary">

                    <i class="bi bi-person-vcard me-2"></i>

                    View Profile

                </a>

            </div>

        </div>

    </div>


    <!-- My Quotations -->

    <div class="col-lg-3 col-md-6">

        <div class="card dashboard-card h-100">

            <div class="card-header">

                <h5 class="mb-0">

                    <i class="bi bi-file-earmark-text-fill"></i>

                    My Quotations

                </h5>

            </div>


            <div class="card-body">

                <div class="module-placeholder">

                    <i class="bi bi-file-earmark-text"></i>

                    <div>

                        <h6>
                            Request & Manage Quotations
                        </h6>

                        <p>
                            Request quotations, review prices and
                            accept or reject quotations from Sales.
                        </p>

                    </div>

                </div>


                <div class="d-flex gap-2 flex-wrap">

                    <a asp-area="Buyer"
                       asp-controller="Quotation"
                       asp-action="Create"
                       class="btn btn-primary">

                        <i class="bi bi-plus-circle me-1"></i>

                        Request Quotation

                    </a>


                    <a asp-area="Buyer"
                       asp-controller="Quotation"
                       asp-action="Index"
                       class="btn btn-outline-primary">

                        <i class="bi bi-file-earmark-text me-1"></i>

                        My Quotations

                    </a>

                </div>

            </div>

        </div>

    </div>


    <!-- Sales Orders -->

    <div class="col-lg-3 col-md-6">

        <div class="card dashboard-card h-100">

            <div class="card-header">

                <h5 class="mb-0">

                    <i class="bi bi-cart-check-fill"></i>

                    Sales Orders

                </h5>

            </div>


            <div class="card-body">

                <div class="module-placeholder">

                    <i class="bi bi-cart3"></i>

                    <div>

                        <h6>
                            My Sales Orders
                        </h6>

                        <p>
                            View and track Sales Orders created
                            from your accepted quotations.
                        </p>

                    </div>

                </div>


                <a asp-area="Buyer"
                   asp-controller="Orders"
                   asp-action="Index"
                   class="btn btn-outline-primary">

                    <i class="bi bi-cart-check me-2"></i>

                    View My Orders

                </a>

            </div>

        </div>

    </div>


    <!-- My Invoices -->

    <div class="col-lg-3 col-md-6">

        <div class="card dashboard-card h-100">

            <div class="card-header">

                <h5 class="mb-0">

                    <i class="bi bi-receipt"></i>

                    My Invoices

                </h5>

            </div>


            <div class="card-body">

                <div class="module-placeholder">

                    <i class="bi bi-receipt"></i>

                    <div>

                        <h6>
                            My Invoices
                        </h6>

                        <p>
                            View your invoices, payment status
                            and outstanding amounts.
                        </p>

                    </div>

                </div>


                <a asp-area="Buyer"
                   asp-controller="Invoice"
                   asp-action="Index"
                   class="btn btn-primary">

                    <i class="bi bi-arrow-right-circle me-2"></i>

                    View My Invoices

                </a>

            </div>

        </div>

    </div>

</div>


<!-- Quotation Workflow -->

<div class="card dashboard-card mt-4">

    <div class="card-header">

        <h5 class="mb-0">

            <i class="bi bi-diagram-3-fill"></i>

            How Your Order Process Works

        </h5>

    </div>


    <div class="card-body">

        <div class="row g-3 text-center">


            <!-- Step 1 -->

            <div class="col-lg">

                <div class="border rounded p-3 h-100">

                    <i class="bi bi-file-earmark-plus fs-3 text-primary"></i>

                    <h6 class="mt-2">
                        Request Quotation
                    </h6>

                    <small class="text-muted">
                        Submit your product requirements
                    </small>

                </div>

            </div>


            <div class="col-lg-auto d-none d-lg-flex align-items-center">

                <i class="bi bi-arrow-right fs-4 text-muted"></i>

            </div>


            <!-- Step 2 -->

            <div class="col-lg">

                <div class="border rounded p-3 h-100">

                    <i class="bi bi-calculator fs-3 text-info"></i>

                    <h6 class="mt-2">
                        Sales Prepares Quote
                    </h6>

                    <small class="text-muted">
                        Sales team sets price and terms
                    </small>

                </div>

            </div>


            <div class="col-lg-auto d-none d-lg-flex align-items-center">

                <i class="bi bi-arrow-right fs-4 text-muted"></i>

            </div>


            <!-- Step 3 -->

            <div class="col-lg">

                <div class="border rounded p-3 h-100">

                    <i class="bi bi-envelope-check fs-3 text-primary"></i>

                    <h6 class="mt-2">
                        Receive Quotation
                    </h6>

                    <small class="text-muted">
                        Review the official quotation
                    </small>

                </div>

            </div>


            <div class="col-lg-auto d-none d-lg-flex align-items-center">

                <i class="bi bi-arrow-right fs-4 text-muted"></i>

            </div>


            <!-- Step 4 -->

            <div class="col-lg">

                <div class="border rounded p-3 h-100">

                    <i class="bi bi-check-circle fs-3 text-success"></i>

                    <h6 class="mt-2">
                        Accept Quotation
                    </h6>

                    <small class="text-muted">
                        Accept the quotation if satisfied
                    </small>

                </div>

            </div>


            <div class="col-lg-auto d-none d-lg-flex align-items-center">

                <i class="bi bi-arrow-right fs-4 text-muted"></i>

            </div>


            <!-- Step 5 -->

            <div class="col-lg">

                <div class="border rounded p-3 h-100">

                    <i class="bi bi-cart-check fs-3 text-success"></i>

                    <h6 class="mt-2">
                        Sales Order
                    </h6>

                    <small class="text-muted">
                        Sales converts accepted quotation
                    </small>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- Account Notice -->

<div class="card dashboard-card mt-4">

    <div class="card-body">

        @if (Model.AccountStatus == "Approved" && Model.IsActive)
        {
            <div class="alert alert-success mb-0">

                <i class="bi bi-check-circle-fill me-2"></i>

                Your buyer account is approved and active.
                You can use the Buyer Portal and request quotations.

            </div>
        }
        else
        {
            <div class="alert alert-warning mb-0">

                <i class="bi bi-hourglass-split me-2"></i>

                Your account is currently waiting for Admin approval.

            </div>
        }

    </div>

</div>