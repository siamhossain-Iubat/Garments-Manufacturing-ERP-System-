@model IEnumerable<GManufacturingERP.Models.Entities.Notification>

@{
    ViewData["Title"] = "Notifications";
    Layout = "~/Areas/Buyer/Views/Shared/_BuyerLayout.cshtml";
}

<div class="page-header">
    <div>
        <small>Buyer Portal</small>

        <h1>Notifications</h1>

        <p>
            Review important updates and action requests related to your orders.
        </p>
    </div>
</div>


<!-- SUCCESS MESSAGE -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">

        <i class="bi bi-check-circle-fill me-2"></i>

        @TempData["SuccessMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}


<!-- ERROR MESSAGE -->
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">

        <i class="bi bi-exclamation-triangle-fill me-2"></i>

        @TempData["ErrorMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}


<div class="card dashboard-card">

    <div class="card-header">

        <h5 class="mb-0">

            <i class="bi bi-bell-fill me-2"></i>

            My Notifications

        </h5>

    </div>


    <div class="card-body">

        @if (Model == null || !Model.Any())
        {
            <!-- NO NOTIFICATIONS -->

            <div class="text-center py-5 text-muted">

                <i class="bi bi-bell-slash fs-1"></i>

                <h5 class="mt-3">
                    No notifications
                </h5>

                <p>
                    You are up to date.
                </p>

            </div>
        }


        @if (Model != null && Model.Any())
        {
            foreach (var notification in Model)
            {
                <div class="border rounded p-3 mb-3
                                    @(notification.IsRead ? "bg-light" : "")">

                    <!-- =========================================
                         NOTIFICATION HEADER
                    ========================================== -->

                    <div class="d-flex justify-content-between align-items-start gap-3">

                        <div class="flex-grow-1">

                            <div class="d-flex align-items-center gap-2 mb-1">

                                <h5 class="mb-0">
                                    @notification.Title
                                </h5>

                                @if (!notification.IsRead)
                                {
                                    <span class="badge bg-primary">
                                        New
                                    </span>
                                }

                            </div>


                            <p class="mb-1">
                                @notification.Message
                            </p>


                            <small class="text-muted">

                                @notification.CreatedAt
                                .ToLocalTime()
                                .ToString("dd MMM yyyy hh:mm tt")

                            </small>

                        </div>


                        <!-- MARK AS READ -->
                        @if (!notification.IsRead)
                        {
                            <form asp-action="MarkAsRead"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@notification.Id" />

                                <button type="submit"
                                        class="btn btn-sm btn-outline-secondary">

                                    <i class="bi bi-check2 me-1"></i>

                                    Mark as Read

                                </button>

                            </form>
                        }

                    </div>


                    <!-- =========================================
                         PARTIAL SHIPMENT REQUEST
                    ========================================== -->
                    @if (notification.Type == "PartialShipment" &&
                                notification.PartialShipmentRequestId.HasValue &&
                                notification.PartialShipmentRequest != null)
                    {
                        var request =
                        notification.PartialShipmentRequest;

                        <hr />


                        <!-- =====================================
                             PENDING
                        ====================================== -->
                        @if (request.Status == "Pending")
                        {
                            <div class="alert alert-warning">

                                <div class="d-flex align-items-start gap-2">

                                    <i class="bi bi-exclamation-circle-fill fs-5"></i>

                                    <div>

                                        <strong>
                                            Partial Shipment Approval Required
                                        </strong>

                                        <div class="mt-1">

                                            Finance has requested your approval
                                            for a partial shipment.

                                        </div>

                                    </div>

                                </div>

                            </div>


                            <!-- REQUEST DETAILS -->

                            <div class="row g-3 mb-3">

                                <div class="col-md-4">

                                    <div class="border rounded p-3">

                                        <small class="text-muted d-block">
                                            Sales Order
                                        </small>

                                        <strong>
                                            @(request.SalesOrder?.OrderNumber ?? "-")
                                        </strong>

                                    </div>

                                </div>


                                <div class="col-md-4">

                                    <div class="border rounded p-3">

                                        <small class="text-muted d-block">
                                            Available Quantity
                                        </small>

                                        <strong>

                                            @request.RequestedQuantity.ToString("0.##")

                                            @(request.FinishedGoodsStock?.Unit ?? "PCS")

                                        </strong>

                                    </div>

                                </div>


                                <div class="col-md-4">

                                    <div class="border rounded p-3">

                                        <small class="text-muted d-block">
                                            Remaining Order
                                        </small>

                                        <strong>

                                            @request.RemainingOrderQuantity.ToString("0.##")

                                            @(request.FinishedGoodsStock?.Unit ?? "PCS")

                                        </strong>

                                    </div>

                                </div>

                            </div>


                            <!-- BUYER RESPONSE -->

                            <form asp-action="PartialShipmentResponse"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="requestId"
                                       value="@request.Id" />


                                <div class="mb-3">

                                    <label class="form-label fw-semibold">

                                        Remarks

                                        <span class="text-muted">
                                            (Optional)
                                        </span>

                                    </label>


                                    <textarea name="remarks"
                              class="form-control"
                              rows="3"
                              placeholder="Add a remark if needed..."></textarea>

                                </div>


                                <div class="d-flex flex-wrap gap-2">

                                    <!-- APPROVE -->

                                    <button type="submit"
                                            name="approve"
                                            value="true"
                                            class="btn btn-success">

                                        <i class="bi bi-check-circle me-1"></i>

                                        Approve Partial Shipment

                                    </button>


                                    <!-- DECLINE -->

                                    <button type="submit"
                                            name="approve"
                                            value="false"
                                            class="btn btn-outline-danger">

                                        <i class="bi bi-x-circle me-1"></i>

                                        Decline

                                    </button>

                                </div>

                            </form>
                        }


                        <!-- =====================================
                             APPROVED
                        ====================================== -->
                        @if (request.Status == "Approved")
                        {
                            <div class="alert alert-success mb-0">

                                <i class="bi bi-check-circle-fill me-2"></i>

                                <strong>
                                    Partial Shipment Approved
                                </strong>

                                <div class="mt-1">

                                    You approved

                                    @request.RequestedQuantity.ToString("0.##")

                                    @(request.FinishedGoodsStock?.Unit ?? "PCS")

                                    for partial shipment.

                                </div>


                                @if (!string.IsNullOrWhiteSpace(
                                                request.BuyerRemarks))
                                {
                                    <div class="mt-2">

                                        <strong>
                                            Your Remarks:
                                        </strong>

                                        @request.BuyerRemarks

                                    </div>
                                }

                            </div>
                        }


                        <!-- =====================================
                             DECLINED
                        ====================================== -->
                        @if (request.Status == "Declined")
                        {
                            <div class="alert alert-danger mb-0">

                                <i class="bi bi-x-circle-fill me-2"></i>

                                <strong>
                                    Partial Shipment Declined
                                </strong>

                                <div class="mt-1">

                                    You declined this partial shipment request.

                                </div>


                                @if (!string.IsNullOrWhiteSpace(
                                                request.BuyerRemarks))
                                {
                                    <div class="mt-2">

                                        <strong>
                                            Your Remarks:
                                        </strong>

                                        @request.BuyerRemarks

                                    </div>
                                }

                            </div>
                        }


                        <!-- =====================================
                             COMPLETED
                        ====================================== -->
                        @if (request.Status == "Completed")
                        {
                            <div class="alert alert-info mb-0">

                                <i class="bi bi-box-seam me-2"></i>

                                <strong>
                                    Partial Shipment Processed
                                </strong>

                                <div class="mt-1">

                                    The approved partial shipment has already
                                    been processed by Finance.

                                </div>

                            </div>
                        }

                    }

                </div>
            }
        }

    </div>

</div>