@model GManufacturingERP.Models.Entities.ApplicationUser

@{
    ViewData["Title"] = "Company Profile";
    Layout = "~/Areas/Buyer/Views/Shared/_BuyerLayout.cshtml";
}

<div class="page-header">

    <div>
        <small>Buyer Portal</small>
        <h1>Company Profile</h1>
        <p>View your registered company information.</p>
    </div>

    <a asp-area="Buyer"
       asp-controller="Dashboard"
       asp-action="Index"
       class="btn btn-outline-primary">
        <i class="bi bi-arrow-left"></i>
        Dashboard
    </a>

</div>

<div class="row g-4">

    <div class="col-lg-8">

        <div class="card dashboard-card">

            <div class="card-header">
                <h5 class="mb-0">
                    <i class="bi bi-building"></i>
                    Company Information
                </h5>
            </div>

            <div class="card-body">

                <div class="row g-4">

                    <div class="col-md-6">
                        <label class="details-label">
                            Company Name
                        </label>

                        <div class="details-value">
                            @Model.CompanyName
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="details-label">
                            Contact Person
                        </label>

                        <div class="details-value">
                            @Model.FullName
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="details-label">
                            Email Address
                        </label>

                        <div class="details-value">
                            @Model.Email
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="details-label">
                            Phone Number
                        </label>

                        <div class="details-value">
                            @Model.PhoneNumber
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="details-label">
                            Country
                        </label>

                        <div class="details-value">
                            @Model.Country
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="details-label">
                            Registration Date
                        </label>

                        <div class="details-value">
                            @(Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy"))
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="details-label">
                            Company Address
                        </label>

                        <div class="details-value">
                            @Model.CompanyAddress
                        </div>
                    </div>

                </div>

            </div>

        </div>

    </div>

    <div class="col-lg-4">

        <div class="card dashboard-card">

            <div class="card-header">
                <h5 class="mb-0">
                    <i class="bi bi-shield-check"></i>
                    Account Status
                </h5>
            </div>

            <div class="card-body">

                <div class="mb-3">
                    <label class="details-label">
                        Approval Status
                    </label>

                    @if (Model.AccountStatus == "Approved")
                    {
                        <span class="badge bg-success">
                            Approved
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">
                            Pending Approval
                        </span>
                    }
                </div>

                <div class="mb-3">
                    <label class="details-label">
                        Email Status
                    </label>

                    @if (Model.EmailConfirmed)
                    {
                        <span class="text-success">
                            <i class="bi bi-check-circle-fill"></i>
                            Verified
                        </span>
                    }
                    else
                    {
                        <span class="text-danger">
                            <i class="bi bi-x-circle-fill"></i>
                            Not Verified
                        </span>
                    }
                </div>

                <div>
                    <label class="details-label">
                        Account Activity
                    </label>

                    @if (Model.IsActive)
                    {
                        <span class="text-success">
                            <i class="bi bi-check-circle-fill"></i>
                            Active
                        </span>
                    }
                    else
                    {
                        <span class="text-danger">
                            <i class="bi bi-x-circle-fill"></i>
                            Inactive
                        </span>
                    }
                </div>

            </div>

        </div>

    </div>

</div>