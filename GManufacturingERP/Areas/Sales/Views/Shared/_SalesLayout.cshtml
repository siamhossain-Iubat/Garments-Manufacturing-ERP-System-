<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - GManufacturing ERP</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/layout.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/dashboard.css"
          asp-append-version="true" />
</head>

<body>

    <div class="app-wrapper">

        <aside class="sidebar">

            <div class="sidebar-brand">
                <i class="bi bi-buildings"></i>
                <span>GManufacturing</span>
            </div>

            <nav class="sidebar-menu">
                <a href="/Sales/Dashboard/Index"
                   class="menu-item">
                    <i class="bi bi-grid-1x2-fill"></i>
                    <span>Dashboard</span>
                </a>
                <a href="/Sales/Buyers/Index"
                   class="menu-item">
                    <i class="bi bi-people-fill"></i>
                    <span>Buyer Management</span>
                </a>
                <a asp-area="Sales"
                   asp-controller="Quotation"
                   asp-action="Index"
                   class="menu-item">

                    <i class="bi bi-file-earmark-text-fill"></i>

                    <span>Quotation Management</span>

                </a>

                <a asp-area="Sales"
                   asp-controller="Orders"
                   asp-action="Index"
                   class="menu-item">
                    <i class="bi bi-cart-check-fill"></i>
                    <span>Sales Orders</span>
                </a>

                <a asp-area="Sales"
                   asp-controller="Orders"
                   asp-action="Pending"
                   class="menu-item">
                    <i class="bi bi-hourglass-split"></i>
                    <span>Pending Orders</span>
                </a>

            </nav>

        </aside>

        <main class="main-content">

            <header class="topbar">

                <div>
                    <h6 class="mb-0">Sales & Buyer Manager</h6>
                    <small>GManufacturing ERP</small>
                </div>

                <div>
                    <form asp-area=""
                          asp-controller="Account"
                          asp-action="Logout"
                          method="post"
                          class="d-inline">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-link nav-link"
                                style="text-decoration: none;">

                            <i class="bi bi-box-arrow-right me-2"></i>
                            Logout

                        </button>

                    </form>
                </div>

            </header>

            <section class="content-area">
                @RenderBody()
            </section>

        </main>

    </div>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>