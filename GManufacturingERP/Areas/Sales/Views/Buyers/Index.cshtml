@model IEnumerable<GManufacturingERP.Models.Entities.ApplicationUser>

@{
    ViewData["Title"] = "Buyer Management";
    Layout = "~/Areas/Sales/Views/Shared/_SalesLayout.cshtml";
}

<div class="page-header">

    <div>
        <small>Sales & Buyer Manager</small>
        <h1>Buyer Management</h1>
        <p>View and manage buyer company information.</p>
    </div>

    <a asp-area="Sales"
       asp-controller="Dashboard"
       asp-action="Index"
       class="btn btn-outline-primary">
        <i class="bi bi-arrow-left"></i>
        Dashboard
    </a>

</div>

<div class="card dashboard-card">

    <div class="card-header d-flex justify-content-between align-items-center">

        <h5 class="mb-0">
            <i class="bi bi-people-fill"></i>
            All Buyer Companies
        </h5>

        <span class="text-muted">
            Total: @Model.Count()
        </span>

    </div>

    <div class="card-body">

        <!-- Search -->
        <form asp-area="Sales"
              asp-controller="Buyers"
              asp-action="Index"
              method="get"
              class="row g-3 mb-4">

            <div class="col-md-9">
                <div class="input-group">

                    <span class="input-group-text">
                        <i class="bi bi-search"></i>
                    </span>

                    <input type="text"
                           name="search"
                           value="@ViewBag.Search"
                           class="form-control"
                           placeholder="Search by company, name, email or country..." />

                </div>
            </div>

            <div class="col-md-3 d-flex gap-2">

                <button type="submit"
                        class="btn btn-primary flex-fill">
                    <i class="bi bi-search"></i>
                    Search
                </button>

                <a asp-area="Sales"
                   asp-controller="Buyers"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-clockwise"></i>
                </a>

            </div>

        </form>

        @if (!Model.Any())
        {
            <div class="empty-state">

                <i class="bi bi-people"></i>

                <h5>No Buyers Found</h5>

                <p>
                    No buyer matches your search criteria.
                </p>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table align-middle">

                    <thead>
                        <tr>
                            <th>Company</th>
                            <th>Contact Person</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Country</th>
                            <th>Status</th>
                            <th>Email</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var buyer in Model)
                        {
                            <tr>

                                <td>
                                    <strong>@buyer.CompanyName</strong>
                                </td>

                                <td>@buyer.FullName</td>

                                <td>@buyer.Email</td>

                                <td>@buyer.PhoneNumber</td>

                                <td>@buyer.Country</td>

                                <td>
                                    @if (buyer.AccountStatus == "Approved")
                                    {
                                        <span class="badge bg-success">
                                            Approved
                                        </span>
                                    }
                                    else if (buyer.AccountStatus == "Rejected")
                                    {
                                        <span class="badge bg-danger">
                                            Rejected
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Pending
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (buyer.EmailConfirmed)
                                    {
                                        <span class="text-success">
                                            <i class="bi bi-check-circle-fill"></i>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-danger">
                                            <i class="bi bi-x-circle-fill"></i>
                                        </span>
                                    }
                                </td>

                                <td>
                                    <a href="@Url.Action(
                                                   "Details",
                                                   "Buyers",
                                                   new
                                                   {
                                                       area = "Sales",
                                                       id = buyer.Id
                                                   })"
                               class="btn btn-sm btn-outline-primary">

                                        <i class="bi bi-eye"></i>
                                        View

                                    </a>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>
</div>