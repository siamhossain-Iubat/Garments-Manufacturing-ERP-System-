@model IEnumerable<GManufacturingERP.Models.Entities.SalesOrder>

@{
    ViewData["Title"] = "Sales Orders";
    Layout = "~/Areas/Sales/Views/Shared/_SalesLayout.cshtml";
}

<div class="page-header">

    ```
    <div>
        <small>Sales & Buyer Manager</small>
        <h1>Sales Orders</h1>
        <p>Review and manage buyer sales orders.</p>
    </div>

    <a asp-area="Sales"
       asp-controller="Dashboard"
       asp-action="Index"
       class="btn btn-outline-primary">
        <i class="bi bi-arrow-left"></i>
        Dashboard
    </a>
    ```

</div>

<div class="card dashboard-card">

    ```
    <div class="card-header d-flex justify-content-between align-items-center">

        <h5 class="mb-0">
            <i class="bi bi-cart-check-fill"></i>
            All Sales Orders
        </h5>

        <span class="text-muted">
            Total: @Model.Count()
        </span>

    </div>

    <div class="card-body">

        @if (!Model.Any())
        {
            <div class="empty-state">

                <i class="bi bi-cart3"></i>

                <h5>No Sales Orders Found</h5>

                <p>
                    Buyer orders will appear here after submission.
                </p>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table align-middle">

                    <thead>
                        <tr>
                            <th>Order Number</th>
                            <th>Company</th>
                            <th>Product</th>
                            <th>Quantity</th>
                            <th>Delivery Date</th>
                            <th>Status</th>
                            <th>Submitted</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var order in Model)
                        {
                            <tr>

                                <td>
                                    <strong>@order.OrderNumber</strong>
                                </td>

                                <td>@order.CompanyName</td>

                                <td>@order.ProductDescription</td>

                                <td>
                                    @order.Quantity @order.Unit
                                </td>

                                <td>
                                    @(order.RequiredDeliveryDate?
                                                                .ToString("dd MMM yyyy") ?? "-")
                        </td>

                                <td>
                            @if (order.OrderStatus == "Approved")
                                    {
                                        <span class="badge bg-success">
                                            Approved
                                        </span>
                                    }
                                    else if (order.OrderStatus == "Rejected")
                                    {
                                        <span class="badge bg-danger">
                                            Rejected
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Pending
                                        </span>
                                    }
                                </td>

                                <td>
                                    @order.CreatedAt.ToLocalTime()
                                    .ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    <a asp-area="Sales"
                                       asp-controller="Orders"
                                       asp-action="Details"
                                       asp-route-id="@order.Id"
                                       class="btn btn-sm btn-outline-primary">

                                        <i class="bi bi-eye"></i>
                                        Review

                                    </a>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>
    

</div>
