@model GManufacturingERP.Models.Entities.Quotation

@{
    ViewData["Title"] = "Quotation Details";
    Layout = "~/Areas/Sales/Views/Shared/_SalesLayout.cshtml";
}

<div class="page-header">

    <div>

        <small>Sales & Buyer Manager</small>

        <h1>Quotation Details</h1>

        <p>
            Review buyer request and manage quotation processing.
        </p>

    </div>

    <a asp-area="Sales"
       asp-controller="Quotation"
       asp-action="Index"
       class="btn btn-outline-primary">

        <i class="bi bi-arrow-left me-1"></i>
        Quotations

    </a>

</div>


@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">

        <i class="bi bi-check-circle-fill me-2"></i>

        @TempData["Success"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}


@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">

        <i class="bi bi-exclamation-triangle-fill me-2"></i>

        @TempData["Error"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}


<div class="row g-4">


    <!-- Main Details -->

    <div class="col-lg-8">

        <div class="card dashboard-card">

            <div class="card-header d-flex justify-content-between align-items-center">

                <h5 class="mb-0">

                    <i class="bi bi-file-earmark-text-fill"></i>

                    @Model.QuotationNumber

                </h5>


                @if (Model.Status == "Requested")
                {
                    <span class="badge bg-secondary">
                        Requested
                    </span>
                }
                else if (Model.Status == "Under Review")
                {
                    <span class="badge bg-warning text-dark">
                        Under Review
                    </span>
                }
                else if (Model.Status == "Prepared")
                {
                    <span class="badge bg-info text-dark">
                        Prepared
                    </span>
                }
                else if (Model.Status == "Sent")
                {
                    <span class="badge bg-primary">
                        Sent
                    </span>
                }
                else if (Model.Status == "Accepted")
                {
                    <span class="badge bg-success">
                        Accepted
                    </span>
                }
                else if (Model.Status == "Rejected")
                {
                    <span class="badge bg-danger">
                        Rejected
                    </span>
                }
                else if (Model.Status == "Converted")
                {
                    <span class="badge bg-success">
                        Converted
                    </span>
                }
                else if (Model.Status == "Cancelled")
                {
                    <span class="badge bg-dark">
                        Cancelled
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary">
                        @Model.Status
                    </span>
                }

            </div>


            <div class="card-body">


                <h6 class="text-primary mb-3">
                    Buyer Information
                </h6>


                <div class="row g-3 mb-4">

                    <div class="col-md-6">

                        <small class="text-muted">
                            Company
                        </small>

                        <div class="fw-semibold">
                            @Model.CompanyName
                        </div>

                    </div>


                    <div class="col-md-6">

                        <small class="text-muted">
                            Contact Person
                        </small>

                        <div class="fw-semibold">
                            @Model.ContactPerson
                        </div>

                    </div>


                    <div class="col-md-6">

                        <small class="text-muted">
                            Email
                        </small>

                        <div>
                            @Model.BuyerEmail
                        </div>

                    </div>


                    <div class="col-md-6">

                        <small class="text-muted">
                            Phone
                        </small>

                        <div>
                            @(Model.BuyerPhone ?? "-")
                        </div>

                    </div>

                </div>


                <hr />


                <h6 class="text-primary mb-3">
                    Product Requirements
                </h6>


                <div class="row g-3 mb-4">

                    <div class="col-12">

                        <small class="text-muted">
                            Product Description
                        </small>

                        <div class="fw-semibold">
                            @Model.ProductDescription
                        </div>

                    </div>


                    <div class="col-md-4">

                        <small class="text-muted">
                            Quantity
                        </small>

                        <div class="fw-semibold">
                            @Model.Quantity @Model.Unit
                        </div>

                    </div>


                    <div class="col-md-4">

                        <small class="text-muted">
                            Required Delivery
                        </small>

                        <div class="fw-semibold">
                            @(Model.RequiredDeliveryDate?.ToString("dd MMM yyyy") ?? "-")
                        </div>

                    </div>


                    <div class="col-md-4">

                        <small class="text-muted">
                            Shipping Country
                        </small>

                        <div class="fw-semibold">
                            @(Model.ShippingCountry ?? "-")
                        </div>

                    </div>


                    <div class="col-12">

                        <small class="text-muted">
                            Shipping Address
                        </small>

                        <div>
                            @(Model.ShippingAddress ?? "-")
                        </div>

                    </div>

                </div>


                @if (Model.GrandTotal > 0)
                {
                    <hr />

                    <h6 class="text-primary mb-3">
                        Quotation Pricing
                    </h6>

                    <div class="table-responsive">

                        <table class="table">

                            <tr>

                                <td>Unit Price</td>

                                <td class="text-end">
                                    @Model.UnitPrice.ToString("N2")
                                </td>

                            </tr>


                            <tr>

                                <td>Subtotal</td>

                                <td class="text-end">
                                    @Model.Subtotal.ToString("N2")
                                </td>

                            </tr>


                            <tr>

                                <td>Discount</td>

                                <td class="text-end text-danger">
                                    - @Model.Discount.ToString("N2")
                                </td>

                            </tr>


                            <tr>

                                <td>Tax</td>

                                <td class="text-end">
                                    @Model.Tax.ToString("N2")
                                </td>

                            </tr>


                            <tr class="table-light">

                                <th>
                                    Grand Total
                                </th>

                                <th class="text-end fs-5">
                                    @Model.GrandTotal.ToString("N2")
                                </th>

                            </tr>

                        </table>

                    </div>
                }


                @if (!string.IsNullOrWhiteSpace(Model.Remarks))
                {
                    <hr />

                    <h6 class="text-primary">
                        Remarks
                    </h6>

                    <p>
                        @Model.Remarks
                    </p>
                }


                @if (!string.IsNullOrWhiteSpace(Model.TermsAndConditions))
                {
                    <hr />

                    <h6 class="text-primary">
                        Terms & Conditions
                    </h6>

                    <p>
                        @Model.TermsAndConditions
                    </p>
                }

            </div>

        </div>

    </div>


    <!-- Workflow -->

    <div class="col-lg-4">


        <div class="card dashboard-card mb-4">

            <div class="card-header">

                <h5 class="mb-0">

                    <i class="bi bi-diagram-3-fill"></i>

                    Quotation Workflow

                </h5>

            </div>


            <div class="card-body">


                @if (Model.Status == "Requested")
                {
                    <div class="alert alert-warning">

                        <strong>
                            New Request
                        </strong>

                        <br />

                        Buyer has submitted a quotation request.

                    </div>


                    <form asp-area="Sales"
                          asp-controller="Quotation"
                          asp-action="Review"
                          asp-route-id="@Model.Id"
                          method="post"
                          class="mb-2">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-warning w-100">

                            <i class="bi bi-search me-1"></i>
                            Start Review

                        </button>

                    </form>
                }


                @if (Model.Status == "Under Review")
                {
                    <div class="alert alert-info">

                        <strong>
                            Under Review
                        </strong>

                        <br />

                        Prepare the official quotation.

                    </div>


                    <a asp-area="Sales"
                       asp-controller="Quotation"
                       asp-action="Prepare"
                       asp-route-id="@Model.Id"
                       class="btn btn-primary w-100">

                        <i class="bi bi-pencil-square me-1"></i>
                        Prepare Quotation

                    </a>
                }


                @if (Model.Status == "Prepared")
                {
                    <div class="alert alert-info">

                        <strong>
                            Quotation Prepared
                        </strong>

                        <br />

                        Review the quotation before sending it to the buyer.

                    </div>


                    <a asp-area="Sales"
                       asp-controller="Quotation"
                       asp-action="Prepare"
                       asp-route-id="@Model.Id"
                       class="btn btn-outline-primary w-100 mb-2">

                        <i class="bi bi-pencil-square me-1"></i>
                        Edit Quotation

                    </a>


                    <form asp-area="Sales"
                          asp-controller="Quotation"
                          asp-action="Send"
                          asp-route-id="@Model.Id"
                          method="post">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-success w-100">

                            <i class="bi bi-send-fill me-1"></i>
                            Send to Buyer

                        </button>

                    </form>
                }


                @if (Model.Status == "Sent")
                {
                    <div class="alert alert-primary mb-0">

                        <i class="bi bi-send-fill me-1"></i>

                        Quotation has been sent to the buyer.

                        <br />

                        Waiting for buyer response.

                    </div>
                }


                @if (Model.Status == "Accepted")
                {
                    <div class="alert alert-success">

                        <i class="bi bi-check-circle-fill me-1"></i>

                        Buyer accepted this quotation.

                    </div>


                    <form asp-area="Sales"
                          asp-controller="Quotation"
                          asp-action="ConvertToSalesOrder"
                          asp-route-id="@Model.Id"
                          method="post">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-success w-100">

                            <i class="bi bi-cart-check-fill me-1"></i>
                            Convert to Sales Order

                        </button>

                    </form>
                }


                @if (Model.Status == "Converted")
                {
                    <div class="alert alert-success mb-0">

                        <i class="bi bi-check-circle-fill me-1"></i>

                        This quotation has already been converted
                        into a Sales Order.

                        @if (Model.SalesOrderId.HasValue)
                        {
                            <hr />

                            <strong>
                                Sales Order ID:
                            </strong>

                            @Model.SalesOrderId
                        }

                    </div>
                }


                @if (Model.Status == "Rejected")
                {
                    <div class="alert alert-danger mb-0">

                        <i class="bi bi-x-circle-fill me-1"></i>

                        Buyer rejected this quotation.

                    </div>
                }


                @if (Model.Status == "Cancelled")
                {
                    <div class="alert alert-dark mb-0">

                        <i class="bi bi-slash-circle-fill me-1"></i>

                        This quotation has been cancelled.

                    </div>
                }


                @if (Model.Status != "Accepted" &&
                                Model.Status != "Converted" &&
                                Model.Status != "Cancelled" &&
                                Model.Status != "Rejected")
                {
                    <hr />


                    <form asp-area="Sales"
                          asp-controller="Quotation"
                          asp-action="Cancel"
                          asp-route-id="@Model.Id"
                          method="post">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-outline-danger w-100"
                                onclick="return confirm('Are you sure you want to cancel this quotation?');">

                            <i class="bi bi-x-circle me-1"></i>
                            Cancel Quotation

                        </button>

                    </form>
                }

            </div>

        </div>


        <!-- Timeline -->

        <div class="card dashboard-card">

            <div class="card-header">

                <h5 class="mb-0">

                    <i class="bi bi-clock-history"></i>

                    Timeline

                </h5>

            </div>


            <div class="card-body">

                <p class="mb-2">

                    <strong>Requested:</strong>

                    @(Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy hh:mm tt"))

                </p>


                @if (Model.ReviewedAt.HasValue)
                {
                    <p class="mb-2">

                        <strong>Reviewed:</strong>

                        @(Model.ReviewedAt.Value
                        .ToLocalTime()
                        .ToString("dd MMM yyyy hh:mm tt"))

                    </p>
                }


                @if (Model.PreparedAt.HasValue)
                {
                    <p class="mb-2">

                        <strong>Prepared:</strong>

                        @(Model.PreparedAt.Value
                        .ToLocalTime()
                        .ToString("dd MMM yyyy hh:mm tt"))

                    </p>
                }


                @if (Model.SentAt.HasValue)
                {
                    <p class="mb-2">

                        <strong>Sent:</strong>

                        @(Model.SentAt.Value
                        .ToLocalTime()
                        .ToString("dd MMM yyyy hh:mm tt"))

                    </p>
                }


                @if (Model.AcceptedAt.HasValue)
                {
                    <p class="mb-2 text-success">

                        <strong>Accepted:</strong>

                        @(Model.AcceptedAt.Value
                        .ToLocalTime()
                        .ToString("dd MMM yyyy hh:mm tt"))

                    </p>
                }


                @if (Model.RejectedAt.HasValue)
                {
                    <p class="mb-2 text-danger">

                        <strong>Rejected:</strong>

                        @(Model.RejectedAt.Value
                        .ToLocalTime()
                        .ToString("dd MMM yyyy hh:mm tt"))

                    </p>
                }

            </div>

        </div>

    </div>

</div>