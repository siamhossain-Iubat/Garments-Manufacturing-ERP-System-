@model GManufacturingERP.Models.Entities.GoodsReceipt

@{
    ViewData["Title"] = "GRN Approval Details";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}


<div class="page-header">

    <div>

        <small>Admin / GRN Approvals</small>

        <h1>GRN Approval Details</h1>

        <p>
            Review Goods Receipt before approving or rejecting it.
        </p>

    </div>


    <a asp-area="Admin"
       asp-controller="GoodsReceiptApprovals"
       asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="bi bi-arrow-left me-1"></i>

        Back

    </a>

</div>


<!-- ========================================================= -->
<!-- GRN INFORMATION -->
<!-- ========================================================= -->

<div class="content-card mb-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <div class="card-title mb-0">

            <i class="bi bi-box-seam me-2"></i>

            @Model.GRNNumber

        </div>


        @if (Model.ReceiptStatus == "Submitted")
        {
            <span class="badge bg-info">
                Pending Approval
            </span>
        }
        else if (Model.ReceiptStatus == "Approved")
        {
            <span class="badge bg-success">
                Approved
            </span>
        }
        else if (Model.ReceiptStatus == "Rejected")
        {
            <span class="badge bg-danger">
                Rejected
            </span>
        }
        else
        {
            <span class="badge bg-warning text-dark">
                @Model.ReceiptStatus
            </span>
        }

    </div>


    <div class="row g-3">

        <div class="col-md-4">

            <small class="text-muted">
                Purchase Order
            </small>

            <div class="fw-semibold">

                @(Model.PurchaseOrder
                                ?.PurchaseOrderNumber ?? "-")

            </div>

        </div>


        <div class="col-md-4">

            <small class="text-muted">
                Receipt Date
            </small>

            <div class="fw-semibold">

                @(Model.ReceiptDate.ToString(
                                "dd MMM yyyy"))

            </div>

        </div>


        <div class="col-md-4">

            <small class="text-muted">
                Received By
            </small>

            <div class="fw-semibold">

                @Model.ReceivedBy

            </div>

        </div>


        <div class="col-md-4">

            <small class="text-muted">
                Delivery Challan
            </small>

            <div class="fw-semibold">

                @(string.IsNullOrWhiteSpace(
                                Model.DeliveryChallanNumber)
                                ? "-"
                                : Model.DeliveryChallanNumber)

            </div>

        </div>


        <div class="col-md-4">

            <small class="text-muted">
                Created At
            </small>

            <div class="fw-semibold">

                @(Model.CreatedAt
                                .ToLocalTime()
                                .ToString("dd MMM yyyy"))

            </div>

        </div>

    </div>


    @if (!string.IsNullOrWhiteSpace(Model.Remarks))
    {
        <div class="mt-3">

            <small class="text-muted">
                Remarks
            </small>

            <p class="mb-0">
                @Model.Remarks
            </p>

        </div>
    }

</div>


<!-- ========================================================= -->
<!-- MATERIAL DETAILS -->
<!-- ========================================================= -->

<div class="content-card mb-4">

    <div class="card-title mb-3">

        <i class="bi bi-box-seam me-2"></i>

        Material Receipt Details

    </div>


    <div class="table-responsive">

        <table class="table align-middle">

            <thead>

                <tr>

                    <th>Material</th>

                    <th>Category</th>

                    <th>Unit</th>

                    <th>Ordered</th>

                    <th>Received</th>

                    <th>Accepted</th>

                    <th>Rejected</th>

                    <th>Remarks</th>

                </tr>

            </thead>


            <tbody>

                @foreach (var item in Model.Items)
                {
                    <tr>

                        <td>
                            @item.MaterialName
                        </td>

                        <td>
                            @item.MaterialCategory
                        </td>

                        <td>
                            @item.Unit
                        </td>

                        <td>
                            @item.OrderedQuantity
                        </td>

                        <td>
                            @item.ReceivedQuantity
                        </td>

                        <td>

                            <span class="text-success fw-semibold">
                                @item.AcceptedQuantity
                            </span>

                        </td>

                        <td>

                            <span class="text-danger fw-semibold">
                                @item.RejectedQuantity
                            </span>

                        </td>

                        <td>
                            @item.Remarks
                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>


<!-- ========================================================= -->
<!-- APPROVAL ACTIONS -->
<!-- ========================================================= -->
@if (Model.ReceiptStatus == "Submitted")
{
    <div class="content-card">

        <div class="card-title mb-3">

            <i class="bi bi-shield-check me-2"></i>

            Admin Decision

        </div>


        <div class="d-flex justify-content-end gap-2">


            <!-- REJECT -->

            <form asp-area="Admin"
                  asp-controller="GoodsReceiptApprovals"
                  asp-action="Reject"
                  asp-route-id="@Model.Id"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="input-group">

                    <input type="text"
                           name="rejectionReason"
                           class="form-control"
                           placeholder="Rejection reason"
                           required />

                    <button type="submit"
                            class="btn btn-danger"
                            onclick="return confirm('Reject this GRN?');">

                        <i class="bi bi-x-circle me-1"></i>

                        Reject

                    </button>

                </div>

            </form>


            <!-- APPROVE -->

            <form asp-area="Admin"
                  asp-controller="GoodsReceiptApprovals"
                  asp-action="Approve"
                  asp-route-id="@Model.Id"
                  method="post">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-success"
                        onclick="return confirm('Approve this GRN?');">

                    <i class="bi bi-check-circle me-1"></i>

                    Approve GRN

                </button>

            </form>

        </div>

    </div>
}
else
{
    <div class="alert alert-secondary">

        <i class="bi bi-info-circle me-2"></i>

        This GRN has already been processed and no further
        approval action is available.

    </div>
}