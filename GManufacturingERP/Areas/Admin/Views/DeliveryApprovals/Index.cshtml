@model IEnumerable<GManufacturingERP.Models.Entities.Delivery>

@{
    ViewData["Title"] = "Delivery Approvals";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    var pendingDeliveries =
        ViewBag.PendingDeliveries
        as IEnumerable<GManufacturingERP.Models.Entities.Delivery>
        ?? Enumerable.Empty<GManufacturingERP.Models.Entities.Delivery>();
}

<div class="page-header mb-4">

    <div>

        <small class="text-muted">
            Admin / Approvals / Delivery
        </small>

        <h1>Delivery Approvals</h1>

        <p class="text-muted mb-0">
            Review and authorize customer delivery records.
        </p>

    </div>

</div>


@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">

        <i class="bi bi-check-circle me-2"></i>

        @TempData["SuccessMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}


@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">

        <i class="bi bi-exclamation-triangle me-2"></i>

        @TempData["ErrorMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}


<!-- =========================================================
     PENDING APPROVALS
========================================================= -->

<div class="card shadow-sm border-0 mb-4">

    <div class="card-header bg-white py-3">

        <h5 class="mb-0">

            <i class="bi bi-hourglass-split me-2"></i>

            Pending Delivery Approvals

            <span class="badge bg-warning text-dark ms-2">
                @pendingDeliveries.Count()
            </span>

        </h5>

    </div>


    <div class="card-body p-0">

        @if (!pendingDeliveries.Any())
        {
            <div class="text-center py-5 text-muted">

                <i class="bi bi-check-circle fs-1"></i>

                <h5 class="mt-3">
                    No Pending Deliveries
                </h5>

                <p class="mb-0">
                    There are no delivery records waiting for approval.
                </p>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th>Delivery No.</th>

                            <th>Dispatch No.</th>

                            <th>Shipment No.</th>

                            <th>Product</th>

                            <th>Quantity</th>

                            <th>Receiver</th>

                            <th>Date</th>

                            <th class="text-end">
                                Action
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var item in pendingDeliveries)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @item.DeliveryNumber
                                    </strong>
                                </td>

                                <td>
                                    @(item.Dispatch?.DispatchNumber ?? "-")
                                </td>

                                <td>
                                    @(item.Dispatch?.Shipment?.ShipmentNumber ?? "-")
                                </td>

                                <td>
                                    @item.ProductName
                                </td>

                                <td>
                                    @item.Quantity.ToString("N2")
                                    @item.Unit
                                </td>

                                <td>
                                    @item.ReceiverName
                                </td>

                                <td>
                                    @item.DeliveryDate
                                    .ToString("dd MMM yyyy")
                                </td>

                                <td class="text-end">

                                    <a asp-area="Admin"
                                       asp-controller="DeliveryApprovals"
                                       asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-primary">

                                        <i class="bi bi-eye me-1"></i>

                                        Review

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>


<!-- =========================================================
     APPROVAL HISTORY
========================================================= -->

<div class="card shadow-sm border-0">

    <div class="card-header bg-white py-3">

        <h5 class="mb-0">

            <i class="bi bi-clock-history me-2"></i>

            Delivery Approval History

        </h5>

    </div>


    <div class="card-body p-0">

        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">

                No approval history available.

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th>Delivery No.</th>

                            <th>Dispatch No.</th>

                            <th>Product</th>

                            <th>Quantity</th>

                            <th>Status</th>

                            <th>Date</th>

                            <th class="text-end">
                                Action
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var item in Model)
                        {
                            var badgeClass =
                            item.Status switch
                            {
                                "Approved" =>
                                            "bg-primary",

                                "Delivered" =>
                                            "bg-success",

                                "Rejected" =>
                                            "bg-danger",

                                "Cancelled" =>
                                            "bg-secondary",

                                _ =>
                                            "bg-warning text-dark"
                            };

                            <tr>

                                <td>
                                    <strong>
                                        @item.DeliveryNumber
                                    </strong>
                                </td>

                                <td>
                                    @(item.Dispatch?.DispatchNumber ?? "-")
                                </td>

                                <td>
                                    @item.ProductName
                                </td>

                                <td>
                                    @item.Quantity.ToString("N2")
                                    @item.Unit
                                </td>

                                <td>

                                    <span class="badge @badgeClass">
                                        @item.Status
                                    </span>

                                </td>

                                <td>
                                    @item.DeliveryDate
                                    .ToString("dd MMM yyyy")
                                </td>

                                <td class="text-end">

                                    <a asp-area="Admin"
                                       asp-controller="DeliveryApprovals"
                                       asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-primary">

                                        <i class="bi bi-eye"></i>

                                        Details

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>