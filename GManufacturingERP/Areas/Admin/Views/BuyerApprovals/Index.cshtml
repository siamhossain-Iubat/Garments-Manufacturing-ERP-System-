@model IEnumerable<GManufacturingERP.Models.Entities.ApplicationUser>

@{
    ViewData["Title"] = "Buyer Approvals";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    var buyers = Model ?? Enumerable.Empty<GManufacturingERP.Models.Entities.ApplicationUser>();
}

<div class="page-header">
    <div>
        <small>Admin Panel</small>

        <h1>
            <i class="bi bi-person-check-fill me-2"></i>
            Buyer Approvals
        </h1>

        <p>Review and approve external buyer accounts.</p>
    </div>

    <a asp-area="Admin"
       asp-controller="BuyerApprovals"
       asp-action="AllBuyers"
       class="btn btn-outline-primary">

        <i class="bi bi-people me-1"></i>
        All Buyers

    </a>
</div>


<!-- SUCCESS MESSAGE -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show"
         role="alert">

        <i class="bi bi-check-circle-fill me-2"></i>

        @TempData["SuccessMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}


<!-- ERROR MESSAGE -->
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show"
         role="alert">

        <i class="bi bi-exclamation-triangle-fill me-2"></i>

        @TempData["ErrorMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}


<div class="card dashboard-card">

    <!-- CARD HEADER -->

    <div class="card-header d-flex justify-content-between align-items-center">

        <div>
            <h5 class="mb-1">
                <i class="bi bi-person-check-fill me-2"></i>
                Pending Buyer Accounts
            </h5>

            <small class="text-muted">
                Review buyer registration requests before approval.
            </small>
        </div>

        <span class="badge bg-primary">
            @buyers.Count() Pending
        </span>

    </div>


    <!-- CARD BODY -->

    <div class="card-body">

        @if (!buyers.Any())
        {
            <div class="empty-state text-center py-5">

                <i class="bi bi-person-check display-4 text-muted"></i>

                <h5 class="mt-3">No Pending Buyers</h5>

                <p class="text-muted">
                    There are no buyer accounts waiting for approval.
                </p>

                <a asp-area="Admin"
                   asp-controller="BuyerApprovals"
                   asp-action="AllBuyers"
                   class="btn btn-outline-primary mt-2">

                    <i class="bi bi-people me-1"></i>
                    View All Buyers

                </a>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Company</th>
                            <th>Contact Person</th>
                            <th>Email</th>
                            <th>Country</th>
                            <th>Registered</th>
                            <th>Status</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @{
                            int serial = 1;
                        }

                        @foreach (var buyer in buyers)
                        {
                            <tr>

                                <!-- SERIAL -->

                                <td>
                                    <span class="text-muted">
                                        @serial
                                    </span>
                                </td>


                                <!-- COMPANY -->

                                <td>
                                    <div class="d-flex align-items-center gap-2">

                                        <div class="buyer-avatar">
                                            <i class="bi bi-building"></i>
                                        </div>

                                        <div>
                                            <strong class="d-block">
                                                @(string.IsNullOrWhiteSpace(buyer.CompanyName)
                                                                                        ? "N/A"
                                                                                        : buyer.CompanyName)
                                                                                                        </strong>

                                            <small class="text-muted">
                                                External Buyer
                                            </small>
                                        </div>

                                    </div>
                                </td>


                                <!-- CONTACT PERSON -->

                                <td>
                                    <strong>
                                        @(string.IsNullOrWhiteSpace(buyer.FullName)
                                                                        ? "N/A"
                                                                        : buyer.FullName)
                                                                                     </strong>
                                                                                 </td>


                                <!-- EMAIL -->

                                <td>
                                    <a href="mailto:@buyer.Email"
                                       class="email-link">

                                        @buyer.Email

                                    </a>
                                </td>


                                <!-- COUNTRY -->

                                <td>
                                    <i class="bi bi-globe2 me-1 text-muted"></i>

                                    @(string.IsNullOrWhiteSpace(buyer.Country)
                                                                ? "N/A"
                                                                : buyer.Country)
                        </td>


                                <!-- REGISTERED DATE -->

                                <td>
                                    <span class="registered-date">
                                        @buyer.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                                    </span>

                                    <small class="d-block text-muted">
                                        @buyer.CreatedAt.ToLocalTime().ToString("hh:mm tt")
                                    </small>
                                </td>


                                <!-- STATUS -->

                                <td>

                            @if (buyer.AccountStatus == "PendingApproval")
                                    {
                                        <span class="status-badge status-pending">
                                            <i class="bi bi-clock me-1"></i>
                                            Pending
                                        </span>
                                    }
                                    else if (buyer.AccountStatus == "Approved")
                                    {
                                        <span class="status-badge status-approved">
                                            <i class="bi bi-check-circle me-1"></i>
                                            Approved
                                        </span>
                                    }
                                    else if (buyer.AccountStatus == "Rejected")
                                    {
                                        <span class="status-badge status-rejected">
                                            <i class="bi bi-x-circle me-1"></i>
                                            Rejected
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-pending">
                                            @buyer.AccountStatus
                                        </span>
                                    }

                                </td>


                                <!-- ACTIONS -->

                                <td>
                                    <div class="action-buttons">

                                        <!-- DETAILS -->

                                        <a asp-area="Admin"
                                           asp-controller="BuyerApprovals"
                                           asp-action="Details"
                                           asp-route-id="@buyer.Id"
                                           class="btn btn-sm btn-outline-primary"
                                           title="View Details">

                                            <i class="bi bi-eye"></i>

                                        </a>


                                        <!-- APPROVE -->
                                        <!-- APPROVE BUYER -->

                                        <form action="/Admin/BuyerApprovals/Approve"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@buyer.Id" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-success"
                                                    title="Approve Buyer"
                                                    onclick="return confirm('Are you sure you want to approve this buyer account?');">

                                                <i class="bi bi-check-lg"></i>

                                            </button>

                                        </form>


                                        <!-- REJECT -->
                                        <!-- REJECT BUYER -->

                                        <form action="/Admin/BuyerApprovals/Reject"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@buyer.Id" />

                                            <input type="hidden"
                                                   name="rejectionReason"
                                                   value="Rejected by Admin" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-danger"
                                                    title="Reject Buyer"
                                                    onclick="return confirm('Are you sure you want to reject this buyer account?');">

                                                <i class="bi bi-x-lg"></i>

                                            </button>

                                        </form>

                                    </div>
                                </td>

                            </tr>

                            serial++;
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>


@section Scripts {

    <script>
        // Automatically hide success/error alerts after 5 seconds

        setTimeout(function () {

            const alerts = document.querySelectorAll('.alert');

            alerts.forEach(function (alert) {

                const alertInstance =
                    bootstrap.Alert.getOrCreateInstance(alert);

                alertInstance.close();

            });

        }, 5000);
    </script>

}