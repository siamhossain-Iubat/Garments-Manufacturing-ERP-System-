@model GManufacturingERP.Models.Entities.ProductionPlan

@{
    ViewData["Title"] = "Review Production Plan";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-header">

    <div>
        <small>Admin / Production Plan Approval</small>
        <h1>Review Production Plan</h1>
        <p>Review the production plan before approval.</p>
    </div>

    <a asp-area="Admin"
       asp-controller="ProductionPlanApprovals"
       asp-action="Index"
       class="btn btn-outline-primary">

        <i class="bi bi-arrow-left"></i>
        Back

    </a>

</div>

<div class="row g-4">

    <div class="col-lg-8">

        <div class="card dashboard-card">

            <div class="card-header">

                <h5 class="mb-0">

                    <i class="bi bi-clipboard-check"></i>

                    @Model.PlanNumber

                </h5>

            </div>

            <div class="card-body">

                <div class="row g-4">

                    <div class="col-md-6">

                        <label class="details-label">
                            Plan Number
                        </label>

                        <div class="details-value">
                            @Model.PlanNumber
                        </div>

                    </div>

                    <div class="col-md-6">

                        <label class="details-label">
                            Sales Order
                        </label>

                        <div class="details-value">
                            @Model.SalesOrder?.OrderNumber
                        </div>

                    </div>

                    <div class="col-md-6">

                        <label class="details-label">
                            Buyer Company
                        </label>

                        <div class="details-value">
                            @Model.BuyerCompany
                        </div>

                    </div>

                    <div class="col-md-6">

                        <label class="details-label">
                            Planned Quantity
                        </label>

                        <div class="details-value">
                            @Model.PlannedQuantity Pieces
                        </div>

                    </div>

                    <div class="col-12">

                        <label class="details-label">
                            Product Description
                        </label>

                        <div class="details-value">
                            @Model.ProductDescription
                        </div>

                    </div>

                    <div class="col-md-6">

                        <label class="details-label">
                            Planned Start Date
                        </label>

                        <div class="details-value">
                            @Model.PlannedStartDate
                            .ToString("dd MMM yyyy")
                        </div>

                    </div>

                    <div class="col-md-6">

                        <label class="details-label">
                            Expected Completion Date
                        </label>

                        <div class="details-value">
                            @Model.ExpectedCompletionDate
                            .ToString("dd MMM yyyy")
                        </div>

                    </div>

                    <div class="col-12">

                        <label class="details-label">
                            Production Remarks
                        </label>

                        <div class="details-value">

                            @(string.IsNullOrWhiteSpace(Model.ProductionRemarks)
                                                        ? "-"
                                                        : Model.ProductionRemarks)

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <div class="col-lg-4">

        <div class="card dashboard-card">

            <div class="card-header">

                <h5 class="mb-0">
                    <i class="bi bi-shield-check"></i>
                    Approval
                </h5>

            </div>

            <div class="card-body">

                <div class="mb-4">

                    <label class="details-label">
                        Current Status
                    </label>

                    <div class="mt-2">

                        @if (Model.ProductionStatus == "PendingApproval")
                        {
                            <span class="badge bg-warning text-dark">
                                Pending Approval
                            </span>
                        }
                        else if (Model.ProductionStatus == "Planned")
                        {
                            <span class="badge bg-success">
                                Approved
                            </span>
                        }
                        else if (Model.ProductionStatus == "Rejected")
                        {
                            <span class="badge bg-danger">
                                Rejected
                            </span>
                        }

                    </div>

                </div>

                @if (Model.ProductionStatus == "PendingApproval")
                {
                    <!-- APPROVE -->

                    <form asp-area="Admin"
                          asp-controller="ProductionPlanApprovals"
                          asp-action="Approve"
                          method="post"
                          class="mb-3">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@Model.Id" />

                        <button type="submit"
                                class="btn btn-success w-100">

                            <i class="bi bi-check-circle-fill"></i>
                            Approve Production Plan

                        </button>

                    </form>

                    <!-- REJECT -->

                    <form asp-area="Admin"
                          asp-controller="ProductionPlanApprovals"
                          asp-action="Reject"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@Model.Id" />

                        <div class="mb-3">

                            <label class="form-label">
                                Rejection Reason
                            </label>

                            <textarea name="rejectionReason"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Enter rejection reason..."></textarea>

                        </div>

                        <button type="submit"
                                class="btn btn-danger w-100">

                            <i class="bi bi-x-circle-fill"></i>
                            Reject Production Plan

                        </button>

                    </form>
                }
                else
                {
                    <div class="alert alert-info mb-0">

                        This production plan has already been
                        processed.

                    </div>
                }

            </div>

        </div>

    </div>

</div>