@using GManufacturingERP.Models.Entities

@{
    ViewData["Title"] = "Production Plan Approvals";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    var pendingPlans =
        ViewBag.PendingPlans as List<ProductionPlan>
        ?? new List<ProductionPlan>();

    var historyPlans =
        ViewBag.HistoryPlans as List<ProductionPlan>
        ?? new List<ProductionPlan>();
}

<div class="page-header">

    <div>
        <small>Admin / Approvals</small>

        <h1>Production Plan Approvals</h1>

        <p>
            Review production plans submitted by the
            Operations & Production Manager.
        </p>
    </div>

</div>


@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">

        <i class="bi bi-check-circle-fill"></i>

        @TempData["SuccessMessage"]

    </div>
}


@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">

        <i class="bi bi-exclamation-triangle-fill"></i>

        @TempData["ErrorMessage"]

    </div>
}


<!-- ========================================================= -->
<!-- PENDING PRODUCTION PLANS -->
<!-- ========================================================= -->

<div class="card dashboard-card mb-4">

    <div class="card-header d-flex justify-content-between align-items-center">

        <h5 class="mb-0">

            <i class="bi bi-clipboard-check"></i>

            Pending Production Plans

        </h5>

        <span class="text-muted">

            Total: @pendingPlans.Count

        </span>

    </div>


    <div class="card-body">

        @if (pendingPlans.Count == 0)
        {
            <div class="empty-state">

                <i class="bi bi-clipboard2-x"></i>

                <h5>
                    No Pending Production Plans
                </h5>

                <p>
                    There are currently no production plans
                    waiting for approval.
                </p>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table align-middle">

                    <thead>

                        <tr>

                            <th>Plan Number</th>

                            <th>Sales Order</th>

                            <th>Buyer</th>

                            <th>Product</th>

                            <th>Quantity</th>

                            <th>Created</th>

                            <th>Status</th>

                            <th>Action</th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var plan in pendingPlans)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @plan.PlanNumber
                                    </strong>
                                </td>


                                <td>
                                    @plan.SalesOrder?.OrderNumber
                                </td>


                                <td>
                                    @plan.BuyerCompany
                                </td>


                                <td>
                                    @plan.ProductDescription
                                </td>


                                <td>
                                    @plan.PlannedQuantity Pieces
                                </td>


                                <td>
                                    @(plan.CreatedAt
                                                                .ToLocalTime()
                                                                .ToString("dd MMM yyyy"))
                        </td>


                                <td>

                                    <span class="badge bg-warning text-dark">
                                        Pending Approval
                                    </span>

                                </td>


                                <td>

                                    <a asp-area="Admin"
                                       asp-controller="ProductionPlanApprovals"
                                       asp-action="Details"
                                       asp-route-id="@plan.Id"
                                       class="btn btn-sm btn-outline-primary">

                                        <i class="bi bi-eye"></i>
                                        Review

                                    </a>

                                </td>

                            </tr>
                                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>



<!-- ========================================================= -->
<!-- APPROVAL HISTORY -->
<!-- ========================================================= -->

<div class="card dashboard-card">

    <div class="card-header d-flex justify-content-between align-items-center">

        <h5 class="mb-0">

            <i class="bi bi-clock-history"></i>

            Approval History

        </h5>

        <span class="text-muted">

            Total: @historyPlans.Count

        </span>

    </div>


    <div class="card-body">

        @if (historyPlans.Count == 0)
        {
            <div class="empty-state">

                <i class="bi bi-clock-history"></i>

                <h5>
                    No Approval History
                </h5>

                <p>
                    Approved or rejected production plans
                    will appear here.
                </p>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table align-middle">

                    <thead>

                        <tr>

                            <th>Plan Number</th>

                            <th>Sales Order</th>

                            <th>Buyer</th>

                            <th>Product</th>

                            <th>Quantity</th>

                            <th>Created</th>

                            <th>Decision</th>

                            <th>Processed</th>

                            <th>Action</th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var plan in historyPlans)
                        {
                            <tr>

                                <td>

                                    <strong>
                                        @plan.PlanNumber
                                    </strong>

                                </td>


                                <td>
                                    @plan.SalesOrder?.OrderNumber
                                </td>


                                <td>
                                    @plan.BuyerCompany
                                </td>


                                <td>
                                    @plan.ProductDescription
                                </td>


                                <td>
                                    @plan.PlannedQuantity Pieces
                                </td>


                                <td>
                                    @(plan.CreatedAt
                                                                .ToLocalTime()
                                                                .ToString("dd MMM yyyy"))
                        </td>


                                <td>

                            @if (plan.ProductionStatus == "Planned")
                                    {
                                        <span class="badge bg-success">

                                            <i class="bi bi-check-circle"></i>
                                            Approved

                                        </span>
                                    }
                                    else if (plan.ProductionStatus == "Rejected")
                                    {
                                        <span class="badge bg-danger">

                                            <i class="bi bi-x-circle"></i>
                                            Rejected

                                        </span>
                                    }
                                    else if (plan.ProductionStatus == "InProgress")
                                    {
                                        <span class="badge bg-primary">

                                            In Progress

                                        </span>
                                    }
                                    else if (plan.ProductionStatus == "Completed")
                                    {
                                        <span class="badge bg-success">

                                            Completed

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">

                                            @plan.ProductionStatus

                                        </span>
                                    }

                                </td>


                                <td>

                                    @if (plan.UpdatedAt.HasValue)
                                    {
                                        @(plan.UpdatedAt.Value
                                                                    .ToLocalTime()
                                                                    .ToString("dd MMM yyyy hh:mm tt"))
                                                        }
                                    else
                                    {
                                        <span>-</span>
                                    }

                                </td>


                                <td>

                                    <a asp-area="Admin"
                                       asp-controller="ProductionPlanApprovals"
                                       asp-action="Details"
                                       asp-route-id="@plan.Id"
                                       class="btn btn-sm btn-outline-primary">

                                        <i class="bi bi-eye"></i>
                                        View

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>