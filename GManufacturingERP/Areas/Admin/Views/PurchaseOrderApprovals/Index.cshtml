@using GManufacturingERP.Models.Entities

@{
    ViewData["Title"] = "Purchase Order Approvals";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    var pendingOrders =
        ViewBag.PendingOrders as List<PurchaseOrder>
        ?? new List<PurchaseOrder>();

    var historyOrders =
        ViewBag.HistoryOrders as List<PurchaseOrder>
        ?? new List<PurchaseOrder>();
}

<div class="page-header">

    <div>

        <small>Admin / Procurement</small>

        <h1>Purchase Order Approvals</h1>

        <p>
            Review Purchase Orders submitted by
            Finance & Logistics.
        </p>

    </div>

</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        <i class="bi bi-check-circle me-2"></i>
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle me-2"></i>
        @TempData["ErrorMessage"]
    </div>
}

<!-- Pending -->

<div class="content-card mb-4">

    <div class="card-title">

        <i class="bi bi-hourglass-split me-2"></i>

        Pending Approval

    </div>

    <div class="table-responsive">

        <table class="table align-middle">

            <thead>

                <tr>

                    <th>PO Number</th>
                    <th>Requisition</th>
                    <th>Supplier</th>
                    <th>Total</th>
                    <th>Order Date</th>
                    <th class="text-end">Action</th>

                </tr>

            </thead>

            <tbody>

                @if (pendingOrders.Any())
                {
                    foreach (var po in pendingOrders)
                    {
                        <tr>

                            <td>
                                <strong>
                                    @po.PurchaseOrderNumber
                                </strong>
                            </td>

                            <td>
                                @po.PurchaseRequisition
                                ?.RequisitionNumber
                            </td>

                            <td>
                                @po.SupplierName
                            </td>

                            <td>
                                @po.GrandTotal.ToString("N2")
                            </td>

                            <td>
                                @po.OrderDate
                                .ToString("dd MMM yyyy")
                            </td>

                            <td class="text-end">

                                <a asp-area="Admin"
                                   asp-controller="PurchaseOrderApprovals"
                                   asp-action="Details"
                                   asp-route-id="@po.Id"
                                   class="btn btn-sm btn-primary">

                                    <i class="bi bi-eye me-1"></i>

                                    Review

                                </a>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="6"
                            class="text-center py-5">

                            <i class="bi bi-check2-circle display-5 text-success"></i>

                            <h5 class="mt-3">
                                No Pending Purchase Orders
                            </h5>

                            <p class="text-muted mb-0">
                                No Purchase Order is waiting
                                for Admin approval.
                            </p>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

<!-- History -->

<div class="content-card">

    <div class="card-title">

        <i class="bi bi-clock-history me-2"></i>

        Approval History

    </div>

    <div class="table-responsive">

        <table class="table align-middle">

            <thead>

                <tr>

                    <th>PO Number</th>
                    <th>Supplier</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th class="text-end">Action</th>

                </tr>

            </thead>

            <tbody>

                @if (historyOrders.Any())
                {
                    foreach (var po in historyOrders)
                    {
                        <tr>

                            <td>
                                <strong>
                                    @po.PurchaseOrderNumber
                                </strong>
                            </td>

                            <td>
                                @po.SupplierName
                            </td>

                            <td>
                                @po.GrandTotal.ToString("N2")
                            </td>

                            <td>

                                @if (po.PurchaseOrderStatus ==
                                                        "Approved")
                                {
                                    <span class="badge bg-success">
                                        Approved
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Rejected
                                    </span>
                                }

                            </td>

                            <td class="text-end">

                                <a asp-area="Admin"
                                   asp-controller="PurchaseOrderApprovals"
                                   asp-action="Details"
                                   asp-route-id="@po.Id"
                                   class="btn btn-sm btn-outline-primary">

                                    <i class="bi bi-eye"></i>
                                    View

                                </a>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="5"
                            class="text-center py-4 text-muted">

                            No approval history available.

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>