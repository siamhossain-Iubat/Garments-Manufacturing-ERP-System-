@model IEnumerable<GManufacturingERP.Models.Entities.ApplicationUser>

@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    DateTime selectedDate = ViewBag.SelectedDate != null
        ? (DateTime)ViewBag.SelectedDate
        : DateTime.Today;
}

<div class="page-header">

    <div>
        <small>Admin Panel</small>

        <h1>Dashboard</h1>

        <p>
            Welcome to GManufacturing ERP administration panel.
        </p>
    </div>

    <!-- Date Picker -->
    <form asp-area="Admin"
          asp-controller="Dashboard"
          asp-action="Index"
          method="get"
          class="dashboard-date">

        <i class="bi bi-calendar3"></i>

        <input type="date"
               id="dashboardDate"
               name="selectedDate"
               class="dashboard-date-input"
               value="@selectedDate.ToString("yyyy-MM-dd")"
               onchange="this.form.submit();" />

    </form>

</div>


<!-- Selected Date Information -->
<div class="selected-date-info mb-4">

    <i class="bi bi-calendar-check"></i>

    Showing dashboard data for:

    <strong>
        @selectedDate.ToString("dd MMMM yyyy")
    </strong>

</div>


<!-- Summary Cards -->
<div class="row g-4 mb-4 align-items-stretch">

    <!-- Total Users -->
    <div class="col-xl-3 col-md-6">

        <div class="summary-card">

            <div class="summary-icon blue">
                <i class="bi bi-people-fill"></i>
            </div>

            <div class="summary-content">

                <span>Total Users</span>

                <h3>@ViewBag.TotalUsers</h3>

                <small>
                    Users registered on selected date
                </small>

            </div>

        </div>

    </div>


    <!-- Total Buyers -->
    <div class="col-xl-3 col-md-6">

        <div class="summary-card">

            <div class="summary-icon orange">
                <i class="bi bi-person-lines-fill"></i>
            </div>

            <div class="summary-content">

                <span>Total Buyers</span>

                <h3>@ViewBag.TotalBuyers</h3>

                <small>
                    Buyers registered on selected date
                </small>

            </div>

        </div>

    </div>


    <!-- Pending Approvals -->
    <div class="col-xl-3 col-md-6">

        <div class="summary-card">

            <div class="summary-icon yellow">
                <i class="bi bi-hourglass-split"></i>
            </div>

            <div class="summary-content">

                <span>Pending Approvals</span>

                <h3>@ViewBag.PendingBuyers</h3>

                <small>
                    Pending buyers on selected date
                </small>

            </div>

        </div>

    </div>


    <!-- Active Buyers -->
    <div class="col-xl-3 col-md-6">

        <div class="summary-card">

            <div class="summary-icon green">
                <i class="bi bi-person-check-fill"></i>
            </div>

            <div class="summary-content">

                <span>Active Buyers</span>

                <h3>@ViewBag.ActiveBuyers</h3>

                <small>
                    Approved buyers registered on selected date
                </small>

            </div>

        </div>

    </div>

</div>


<!-- Placeholder Module Cards -->
<div class="row g-4 mb-4">

    <!-- Sales & Orders -->
    <div class="col-lg-6">

        <div class="card dashboard-card h-100">

            <div class="card-header">

                <h5 class="mb-0">

                    <i class="bi bi-cart-check"></i>

                    Sales & Orders

                </h5>

            </div>

            <div class="card-body">

                <div class="module-placeholder">

                    <i class="bi bi-cart3"></i>

                    <div>

                        <h6>Order Management</h6>

                        <p>
                            Sales orders and buyer orders will appear here
                            after the Sales module is created.
                        </p>

                    </div>

                </div>

                <button class="btn btn-outline-primary btn-sm"
                        disabled>

                    Coming Soon

                </button>

            </div>

        </div>

    </div>


    <!-- Production -->
    <div class="col-lg-6">

        <div class="card dashboard-card h-100">

            <div class="card-header">

                <h5 class="mb-0">

                    <i class="bi bi-gear-wide-connected"></i>

                    Production

                </h5>

            </div>

            <div class="card-body">

                <div class="module-placeholder">

                    <i class="bi bi-gear-fill"></i>

                    <div>

                        <h6>Production Management</h6>

                        <p>
                            Production planning and manufacturing progress
                            will appear here.
                        </p>

                    </div>

                </div>

                <button class="btn btn-outline-primary btn-sm"
                        disabled>

                    Coming Soon

                </button>

            </div>

        </div>

    </div>

</div>


<!-- Recent Buyer Registrations -->
<div class="card dashboard-card">

    <div class="card-header d-flex justify-content-between align-items-center">

        <h5 class="mb-0">

            <i class="bi bi-person-plus-fill"></i>

            Buyer Registrations on
            @selectedDate.ToString("dd MMM yyyy")

        </h5>

        <a asp-area="Admin"
           asp-controller="BuyerApprovals"
           asp-action="AllBuyers"
           class="btn btn-sm btn-outline-primary">

            View All

        </a>

    </div>


    <div class="card-body">

        @if (Model == null || !Model.Any())
        {
            <div class="empty-state">

                <i class="bi bi-people"></i>

                <h5>No Buyers Found</h5>

                <p>
                    No external buyer registered on
                    @selectedDate.ToString("dd MMMM yyyy").
                </p>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table align-middle">

                    <thead>

                        <tr>

                            <th>Company</th>

                            <th>Contact Person</th>

                            <th>Email</th>

                            <th>Country</th>

                            <th>Status</th>

                            <th>Registered</th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var buyer in Model)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @buyer.CompanyName
                                    </strong>
                                </td>

                                <td>
                                    @buyer.FullName
                                </td>

                                <td>
                                    @buyer.Email
                                </td>

                                <td>
                                    @buyer.Country
                                </td>

                                <td>

                                    @if (buyer.AccountStatus == "Approved")
                                    {
                                        <span class="badge bg-success">
                                            Approved
                                        </span>
                                    }
                                    else if (buyer.AccountStatus == "Rejected")
                                    {
                                        <span class="badge bg-danger">
                                            Rejected
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Pending
                                        </span>
                                    }

                                </td>

                                <td>
                                    @buyer.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>


@section Scripts {

    <script>

        const dashboardDate =
            document.getElementById("dashboardDate");

        if (dashboardDate) {

            dashboardDate.addEventListener("change", function () {

                this.form.submit();

            });

        }

    </script>

}