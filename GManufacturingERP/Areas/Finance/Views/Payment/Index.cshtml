@model IEnumerable<GManufacturingERP.Models.Entities.Payment>

@{
    ViewData["Title"] = "Payments";
    Layout = "~/Areas/Finance/Views/Shared/_FinanceLayout.cshtml";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <small class="text-muted">
            Finance & Logistics / Payment
        </small>

        <h1 class="mb-1">
            Payment Management
        </h1>

        <p class="text-muted mb-0">
            SSLCOMMERZ payment transactions
        </p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        <i class="bi bi-check-circle me-2"></i>
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle me-2"></i>
        @TempData["ErrorMessage"]
    </div>
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white">
        <h5 class="mb-0">
            <i class="bi bi-cash-stack me-2"></i>
            Payment Transactions
        </h5>
    </div>

    <div class="card-body p-0">

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-cash-stack fs-1 text-muted"></i>

                <h5 class="mt-3">
                    No payment transactions found
                </h5>

                <p class="text-muted">
                    Payments will appear here after customers make payments.
                </p>
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Payment No.</th>
                            <th>Invoice</th>
                            <th>Buyer</th>
                            <th>Amount</th>
                            <th>Method</th>
                            <th>Transaction</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            var badgeClass = item.Status switch
                            {
                                "Completed" => "bg-success",
                                "Pending" => "bg-warning text-dark",
                                "Failed" => "bg-danger",
                                "Cancelled" => "bg-secondary",
                                "Expired" => "bg-dark",
                                _ => "bg-secondary"
                            };

                            <tr>

                                <td>
                                    <strong>
                                        @item.PaymentNumber
                                    </strong>
                                </td>

                                <td>
                                    @item.Invoice?.InvoiceNumber
                                </td>

                                <td>
                                    @item.BuyerName
                                </td>

                                <td>
                                    <strong>
                                        ৳ @item.Amount.ToString("N2")
                                    </strong>
                                </td>

                                <td>
                                    <span class="badge bg-primary">
                                        @item.PaymentMethod
                                    </span>
                                </td>

                                <td>
                                    <small>
                                        @item.TransactionId
                                    </small>
                                </td>

                                <td>
                                    @item.PaymentDate.ToLocalTime()
                                    .ToString("dd MMM yyyy hh:mm tt")
                                </td>

                                <td>
                                    <span class="badge @badgeClass">
                                        @item.Status
                                    </span>
                                </td>

                                <td>
                                    <a asp-area="Finance"
                                       asp-controller="Payment"
                                       asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-primary">

                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>
</div>