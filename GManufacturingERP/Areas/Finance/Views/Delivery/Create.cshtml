@model GManufacturingERP.ViewModels.CreateDeliveryViewModel

@{
    ViewData["Title"] = "Create Delivery";
    Layout = "~/Areas/Finance/Views/Shared/_FinanceLayout.cshtml";
}

<div class="page-header mb-4">

    <small class="text-muted">
        Finance & Logistics / Delivery / Create
    </small>

    <h1>Create Delivery</h1>

    <p class="text-muted mb-0">
        Create a delivery record from an in-transit dispatch.
    </p>

</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">

        <div asp-validation-summary="All"></div>

    </div>
}

<div class="row g-4">

    <div class="col-lg-5">

        <div class="card shadow-sm border-0">

            <div class="card-header bg-white">

                <h5 class="mb-0">
                    <i class="bi bi-truck me-2"></i>
                    Dispatch Information
                </h5>

            </div>

            <div class="card-body">

                <div class="mb-3">

                    <label class="form-label text-muted">
                        Dispatch Number
                    </label>

                    <input class="form-control"
                           value="@Model.DispatchNumber"
                           readonly />

                </div>

                <div class="mb-3">

                    <label class="form-label text-muted">
                        Shipment Number
                    </label>

                    <input class="form-control"
                           value="@Model.ShipmentNumber"
                           readonly />

                </div>

                <div class="mb-3">

                    <label class="form-label text-muted">
                        Product
                    </label>

                    <input class="form-control"
                           value="@Model.ProductName"
                           readonly />

                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label class="form-label text-muted">
                            Dispatch Quantity
                        </label>

                        <input class="form-control"
                               value="@Model.DispatchQuantity.ToString("N2") @Model.Unit"
                               readonly />

                    </div>

                    <div class="col-md-6 mb-3">

                        <label class="form-label text-muted">
                            Dispatch Cartons
                        </label>

                        <input class="form-control"
                               value="@Model.DispatchCartons"
                               readonly />

                    </div>

                </div>

            </div>

        </div>

    </div>

    <div class="col-lg-7">

        <form asp-action="Create" method="post">

            @Html.AntiForgeryToken()

            <input asp-for="DispatchId" type="hidden" />

            <div class="card shadow-sm border-0">

                <div class="card-header bg-white">

                    <h5 class="mb-0">
                        <i class="bi bi-box2-heart me-2"></i>
                        Delivery Details
                    </h5>

                </div>

                <div class="card-body">

                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label asp-for="DeliveryQuantity"
                                   class="form-label">
                                Delivered Quantity
                            </label>

                            <div class="input-group">

                                <input asp-for="DeliveryQuantity"
                                       class="form-control" />

                                <span class="input-group-text">
                                    @Model.Unit
                                </span>

                            </div>

                            <span asp-validation-for="DeliveryQuantity"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-6 mb-3">

                            <label asp-for="TotalCartons"
                                   class="form-label">
                                Total Cartons
                            </label>

                            <input asp-for="TotalCartons"
                                   class="form-control" />

                            <span asp-validation-for="TotalCartons"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                    <div class="mb-3">

                        <label asp-for="DeliveryDate"
                               class="form-label">
                            Delivery Date
                        </label>

                        <input asp-for="DeliveryDate"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="DeliveryDate"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label asp-for="ReceiverName"
                                   class="form-label">
                                Receiver Name
                            </label>

                            <input asp-for="ReceiverName"
                                   class="form-control"
                                   placeholder="Enter receiver name" />

                            <span asp-validation-for="ReceiverName"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-6 mb-3">

                            <label asp-for="ReceiverPhone"
                                   class="form-label">
                                Receiver Phone
                            </label>

                            <input asp-for="ReceiverPhone"
                                   class="form-control"
                                   placeholder="Enter phone number" />

                            <span asp-validation-for="ReceiverPhone"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                    <div class="mb-3">

                        <label asp-for="DeliveryAddress"
                               class="form-label">
                            Delivery Address
                        </label>

                        <textarea asp-for="DeliveryAddress"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Enter delivery address"></textarea>

                        <span asp-validation-for="DeliveryAddress"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="Remarks"
                               class="form-label">
                            Remarks
                        </label>

                        <textarea asp-for="Remarks"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Optional remarks"></textarea>

                    </div>

                </div>

                <div class="card-footer bg-white d-flex justify-content-between">

                    <a asp-area="Finance"
                       asp-controller="Dispatch"
                       asp-action="Details"
                       asp-route-id="@Model.DispatchId"
                       class="btn btn-outline-secondary">

                        <i class="bi bi-arrow-left"></i>
                        Back

                    </a>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-check-circle"></i>
                        Create Delivery

                    </button>

                </div>

            </div>

        </form>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}