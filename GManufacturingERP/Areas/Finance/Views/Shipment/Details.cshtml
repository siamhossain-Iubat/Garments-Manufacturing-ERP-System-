@model GManufacturingERP.Models.Entities.Shipment

@{
    ViewData["Title"] = "Shipment Details";
    Layout = "~/Areas/Finance/Views/Shared/_FinanceLayout.cshtml";

    var badgeClass = Model.Status switch
    {
        "Draft" => "bg-secondary",
        "Ready for Dispatch" => "bg-warning text-dark",
        "Dispatched" => "bg-primary",
        "In Transit" => "bg-info text-dark",
        "Delivered" => "bg-success",
        "Cancelled" => "bg-danger",
        _ => "bg-secondary"
    };
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">

    <div>
        <small class="text-muted">
            Finance & Logistics / Shipment / Details
        </small>

        <h1 class="mb-1">
            @Model.ShipmentNumber
        </h1>

        <p class="text-muted mb-0">
            Shipment details and status management
        </p>
    </div>

    <span class="badge @badgeClass fs-6 px-3 py-2">
        @Model.Status
    </span>

</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>
        @TempData["SuccessMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle me-2"></i>
        @TempData["ErrorMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">

    <div class="col-lg-8">

        <div class="card shadow-sm border-0">

            <div class="card-header bg-white">
                <h5 class="mb-0">
                    <i class="bi bi-truck me-2"></i>
                    Shipment Information
                </h5>
            </div>

            <div class="card-body">

                <div class="row g-3">

                    <div class="col-md-6">
                        <label class="text-muted small">
                            Shipment Number
                        </label>

                        <div class="fw-semibold">
                            @Model.ShipmentNumber
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="text-muted small">
                            Packing Number
                        </label>

                        <div class="fw-semibold">
                            @Model.Packing?.PackingNumber
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="text-muted small">
                            Product
                        </label>

                        <div class="fw-semibold">
                            @Model.ProductName
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="text-muted small">
                            Quantity
                        </label>

                        <div class="fw-semibold">
                            @Model.Quantity.ToString("N2")
                            @Model.Unit
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="text-muted small">
                            Total Cartons
                        </label>

                        <div class="fw-semibold">
                            @Model.TotalCartons
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="text-muted small">
                            Shipment Date
                        </label>

                        <div class="fw-semibold">
                            @Model.ShipmentDate.ToString("dd MMM yyyy")
                        </div>
                    </div>

                    <div class="col-12">
                        <hr />
                    </div>

                    <div class="col-md-6">
                        <label class="text-muted small">
                            Transport / Courier
                        </label>

                        <div>
                            @(string.IsNullOrWhiteSpace(Model.TransportName)
                                                        ? "Not specified"
                                                        : Model.TransportName)
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="text-muted small">
                            Vehicle Number
                        </label>

                        <div>
                            @(string.IsNullOrWhiteSpace(Model.VehicleNumber)
                                                        ? "Not specified"
                                                        : Model.VehicleNumber)
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="text-muted small">
                            Tracking Number
                        </label>

                        <div>
                            @(string.IsNullOrWhiteSpace(Model.TrackingNumber)
                                                        ? "Not specified"
                                                        : Model.TrackingNumber)
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="text-muted small">
                            Created By
                        </label>

                        <div>
                            @Model.CreatedBy
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="text-muted small">
                            Shipping Address
                        </label>

                        <div>
                            @(string.IsNullOrWhiteSpace(Model.ShippingAddress)
                                                        ? "Not specified"
                                                        : Model.ShippingAddress)
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="text-muted small">
                            Remarks
                        </label>

                        <div>
                            @(string.IsNullOrWhiteSpace(Model.Remarks)
                                                        ? "No remarks"
                                                        : Model.Remarks)
                        </div>
                    </div>

                </div>

            </div>

        </div>

    </div>

    <div class="col-lg-4">

        <div class="card shadow-sm border-0 mb-4">

            <div class="card-header bg-white">
                <h5 class="mb-0">
                    <i class="bi bi-arrow-repeat me-2"></i>
                    Shipment Status
                </h5>
            </div>

            <div class="card-body">

                @* Draft → Ready for Dispatch *@
                @if (Model.Status == "Draft")
                {
                    <form asp-action="ReadyForDispatch"
                          method="post"
                          class="mb-2">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@Model.Id" />

                        <button type="submit"
                                class="btn btn-warning w-100">
                            <i class="bi bi-check2-circle me-2"></i>
                            Ready for Dispatch
                        </button>

                    </form>
                }

                @* Ready for Dispatch → Create Dispatch *@
                @if (Model.Status == "Ready for Dispatch")
                {
                    <a asp-area="Finance"
                       asp-controller="Dispatch"
                       asp-action="Create"
                       asp-route-shipmentId="@Model.Id"
                       class="btn btn-primary w-100 mb-2">

                        <i class="bi bi-truck me-2"></i>
                        Create Dispatch

                    </a>
                }

                @* Dispatched → In Transit *@
                @if (Model.Status == "Dispatched")
                {
                    <form asp-action="InTransit"
                          method="post"
                          class="mb-2">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@Model.Id" />

                        <button type="submit"
                                class="btn btn-info w-100">

                            <i class="bi bi-geo-alt me-2"></i>
                            Mark In Transit

                        </button>

                    </form>
                }

                @* In Transit → Delivered *@
                @if (Model.Status == "In Transit")
                {
                    <form asp-action="Deliver"
                          method="post"
                          class="mb-2">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@Model.Id" />

                        <button type="submit"
                                class="btn btn-success w-100">

                            <i class="bi bi-box2-heart me-2"></i>
                            Mark Delivered

                        </button>

                    </form>
                }

                @* Cancel Shipment *@
                @if (Model.Status != "Delivered" &&
                                Model.Status != "Cancelled")
                {
                    <form asp-action="Cancel"
                          method="post"
                          onsubmit="return confirm('Are you sure you want to cancel this shipment?');">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@Model.Id" />

                        <button type="submit"
                                class="btn btn-outline-danger w-100">

                            <i class="bi bi-x-circle me-2"></i>
                            Cancel Shipment

                        </button>

                    </form>
                }

            </div>

        </div>

        <div class="card shadow-sm border-0">

            <div class="card-header bg-white">
                <h5 class="mb-0">
                    <i class="bi bi-clock-history me-2"></i>
                    Timeline
                </h5>
            </div>

            <div class="card-body">

                <div class="mb-3">

                    <small class="text-muted">
                        Created
                    </small>

                    <div>
                        @Model.CreatedAt
                        .ToLocalTime()
                        .ToString("dd MMM yyyy, hh:mm tt")
                    </div>

                </div>

                @if (Model.DispatchedAt.HasValue)
                {
                    <div class="mb-3">

                        <small class="text-muted">
                            Dispatched
                        </small>

                        <div>
                            @Model.DispatchedAt.Value
                            .ToLocalTime()
                            .ToString("dd MMM yyyy, hh:mm tt")
                        </div>

                    </div>
                }

                @if (Model.DeliveredAt.HasValue)
                {
                    <div>

                        <small class="text-muted">
                            Delivered
                        </small>

                        <div>
                            @Model.DeliveredAt.Value
                            .ToLocalTime()
                            .ToString("dd MMM yyyy, hh:mm tt")
                        </div>

                    </div>
                }

            </div>

        </div>

    </div>

</div>

<div class="mt-4">

    <a asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="bi bi-arrow-left me-1"></i>
        Back to Shipments

    </a>

    @if (Model.Packing != null)
    {
        <a asp-area="Finance"
           asp-controller="Packing"
           asp-action="Details"
           asp-route-id="@Model.PackingId"
           class="btn btn-outline-primary">

            <i class="bi bi-box-seam me-1"></i>
            View Packing

        </a>
    }

</div>