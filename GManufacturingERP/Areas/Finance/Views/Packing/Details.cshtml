@model GManufacturingERP.Models.Entities.Packing

@{
    ViewData["Title"] = "Packing Details";
    Layout = "~/Areas/Finance/Views/Shared/_FinanceLayout.cshtml";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <small class="text-muted">
                Finance & Logistics / Packing / Details
            </small>

            <h2 class="fw-bold mt-1">
                @Model.PackingNumber
            </h2>

        </div>


        <div class="d-flex gap-2">

            @* ==========================================
               CREATE SHIPMENT
               Only Packed Packing can create shipment
               ========================================== *@

            @if (Model.Status == "Packed")
            {
                <a asp-area="Finance"
                   asp-controller="Shipment"
                   asp-action="Create"
                   asp-route-packingId="@Model.Id"
                   class="btn btn-primary">

                    <i class="bi bi-truck me-1"></i>

                    Create Shipment

                </a>
            }


            @* ==========================================
               BACK TO PACKING
               ========================================== *@

            <a asp-area="Finance"
               asp-controller="Packing"
               asp-action="Index"
               class="btn btn-secondary">

                Back to Packing

            </a>

        </div>

    </div>


    <div class="row g-4">

        <div class="col-lg-4">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-white">

                    <h5 class="mb-0">
                        Packing Information
                    </h5>

                </div>


                <div class="card-body">

                    <p>
                        <strong>Packing Number:</strong>
                        @Model.PackingNumber
                    </p>


                    <p>

                        <strong>Sales Order:</strong>

                        @if (Model.SalesOrder != null)
                        {
                            <span>
                                SO-@Model.SalesOrder.Id
                            </span>
                        }
                        else
                        {
                            <span>N/A</span>
                        }

                    </p>


                    <p>

                        <strong>Packing Date:</strong>

                        @Model.PackingDate.ToLocalTime()

                    </p>


                    <p>

                        <strong>Shipment Type:</strong>

                        @if (Model.ShipmentType == "PartialShipment")
                        {
                            <span class="badge bg-warning text-dark">

                                Partial Shipment

                            </span>
                        }
                        else
                        {
                            <span class="badge bg-success">

                                Full Shipment

                            </span>
                        }

                    </p>


                    <p>

                        <strong>Status:</strong>

                        @if (Model.Status == "Packed")
                        {
                            <span class="badge bg-success">

                                Packed

                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">

                                @Model.Status

                            </span>
                        }

                    </p>


                    <p>

                        <strong>Total Quantity:</strong>

                        @Model.TotalQuantity

                    </p>


                    <p>

                        <strong>Total Cartons:</strong>

                        @Model.TotalCartons

                    </p>


                    <p>

                        <strong>Packed By:</strong>

                        @Model.PackedBy

                    </p>


                    <p>

                        <strong>Packed At:</strong>

                        @Model.PackedAt?.ToLocalTime()

                    </p>


                    @if (Model.PartialShipmentApproved)
                    {
                        <div class="alert alert-info">

                            <strong>
                                Partial Shipment Approved
                            </strong>

                            <br />

                            Approved By:
                            @Model.ApprovedBy

                            <br />

                            Approved At:
                            @Model.ApprovedAt?.ToLocalTime()

                        </div>
                    }


                    @if (!string.IsNullOrWhiteSpace(Model.Remarks))
                    {
                        <div class="mt-3">

                            <strong>
                                Remarks
                            </strong>

                            <p class="text-muted">

                                @Model.Remarks

                            </p>

                        </div>
                    }

                </div>

            </div>

        </div>


        <div class="col-lg-8">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-white">

                    <h5 class="mb-0">
                        Packing Items
                    </h5>

                </div>


                <div class="card-body p-0">

                    <div class="table-responsive">

                        <table class="table table-hover mb-0">

                            <thead class="table-light">

                                <tr>

                                    <th>
                                        Product
                                    </th>

                                    <th>
                                        Unit
                                    </th>

                                    <th>
                                        Quantity
                                    </th>

                                    <th>
                                        Cartons
                                    </th>

                                    <th>
                                        Qty / Carton
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                @if (Model.Items != null &&
                                                                Model.Items.Any())
                                {
                                    @foreach (var item in Model.Items)
                                    {
                                        <tr>

                                            <td>
                                                @item.ProductName
                                            </td>

                                            <td>
                                                @item.Unit
                                            </td>

                                            <td>
                                                @item.Quantity
                                            </td>

                                            <td>
                                                @item.CartonNumber
                                            </td>

                                            <td>
                                                @item.QuantityPerCarton
                                            </td>

                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>

                                        <td colspan="5"
                                            class="text-center text-muted py-4">

                                            No packing items found.

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>