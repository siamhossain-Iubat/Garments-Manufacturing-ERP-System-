@model GManufacturingERP.ViewModels.CreatePackingViewModel

@{
    ViewData["Title"] = "Create Packing";
    Layout = "~/Areas/Finance/Views/Shared/_FinanceLayout.cshtml";
}

<div class="container-fluid py-4">

    <div class="page-header d-flex justify-content-between align-items-center mb-4">

        <div>
            <small>Finance & Logistics / Packing / Create</small>

            <h1>
                <i class="bi bi-box-seam me-2"></i>
                Create Packing
            </h1>

            <p class="text-muted mb-0">
                Prepare finished goods for shipment.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Back

        </a>

    </div>

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger">
    </div>

    <div class="row g-4">

        <div class="col-lg-8">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-primary text-white">

                    <h5 class="mb-0">
                        <i class="bi bi-box-seam me-2"></i>
                        Packing Information
                    </h5>

                </div>

                <div class="card-body">

                    <form asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="FinishedGoodsStockId" />

                        <input type="hidden"
                               asp-for="SalesOrderId" />

                        <div class="row g-3">

                            <div class="col-md-6">

                                <label class="form-label fw-semibold">
                                    Product Name
                                </label>

                                <input type="text"
                                       class="form-control"
                                       value="@Model.ProductName"
                                       readonly />

                            </div>

                            <div class="col-md-6">

                                <label class="form-label fw-semibold">
                                    Sales Order
                                </label>

                                <input type="text"
                                       class="form-control"
                                       value="@(Model.SalesOrderNumber ?? "-")"
                                       readonly />

                            </div>

                            <div class="col-md-6">

                                <label class="form-label fw-semibold">
                                    Available Quantity
                                </label>

                                <input type="text"
                                       class="form-control"
                                       value="@Model.AvailableQuantity @Model.Unit"
                                       readonly />

                            </div>

                            <div class="col-md-6">

                                <label asp-for="PackingDate"
                                       class="form-label fw-semibold">
                                    Packing Date
                                </label>

                                <input asp-for="PackingDate"
                                       type="date"
                                       class="form-control" />

                                <span asp-validation-for="PackingDate"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="col-md-6">

                                <label asp-for="PackingQuantity"
                                       class="form-label fw-semibold">
                                    Packing Quantity
                                </label>

                                <input asp-for="PackingQuantity"
                                       class="form-control"
                                       id="packingQuantity" />

                                <span asp-validation-for="PackingQuantity"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="col-md-6">

                                <label asp-for="TotalCartons"
                                       class="form-label fw-semibold">
                                    Total Cartons
                                </label>

                                <input asp-for="TotalCartons"
                                       type="number"
                                       min="1"
                                       class="form-control"
                                       id="totalCartons" />

                                <span asp-validation-for="TotalCartons"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="col-md-6">

                                <label asp-for="QuantityPerCarton"
                                       class="form-label fw-semibold">
                                    Quantity Per Carton
                                </label>

                                <input asp-for="QuantityPerCarton"
                                       class="form-control"
                                       id="quantityPerCarton" />

                                <span asp-validation-for="QuantityPerCarton"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="col-md-6">

                                <label class="form-label fw-semibold">
                                    Unit
                                </label>

                                <input type="text"
                                       class="form-control"
                                       value="@Model.Unit"
                                       readonly />

                            </div>

                            <div class="col-12">

                                <label asp-for="Remarks"
                                       class="form-label fw-semibold">
                                    Remarks
                                </label>

                                <textarea asp-for="Remarks"
                                          class="form-control"
                                          rows="3"
                                          placeholder="Enter packing remarks..."></textarea>

                                <span asp-validation-for="Remarks"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>

                        <hr class="my-4" />

                        <div class="d-flex justify-content-end gap-2">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary">

                                Cancel

                            </a>

                            <button type="submit"
                                    class="btn btn-primary">

                                <i class="bi bi-check-circle me-1"></i>
                                Create Packing

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

        <div class="col-lg-4">

            <div class="card shadow-sm border-0">

                <div class="card-header">

                    <h5 class="mb-0">
                        <i class="bi bi-info-circle me-2"></i>
                        Packing Summary
                    </h5>

                </div>

                <div class="card-body">

                    <div class="mb-4">

                        <small class="text-muted">
                            Product
                        </small>

                        <h5 class="mb-0">
                            @Model.ProductName
                        </h5>

                    </div>

                    <div class="mb-4">

                        <small class="text-muted">
                            Available Quantity
                        </small>

                        <h3 class="text-success mb-0">
                            @Model.AvailableQuantity @Model.Unit
                        </h3>

                    </div>

                    <div>

                        <small class="text-muted">
                            Initial Status
                        </small>

                        <div class="mt-1">

                            <span class="badge bg-warning text-dark">
                                Draft
                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}