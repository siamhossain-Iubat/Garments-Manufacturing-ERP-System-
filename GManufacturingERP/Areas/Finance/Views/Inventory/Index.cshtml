@model IEnumerable<GManufacturingERP.Models.Entities.InventoryStock>

@{
    ViewData["Title"] = "Inventory Stock";
    Layout = "~/Areas/Finance/Views/Shared/_FinanceLayout.cshtml";
}

<div class="page-header">

    <div>

        <small>Finance & Logistics / Inventory</small>

        <h1>Inventory Stock</h1>

        <p>
            Monitor available materials and current stock levels.
        </p>

    </div>

</div>


@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">

        <i class="bi bi-check-circle me-2"></i>

        @TempData["SuccessMessage"]

    </div>
}


@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">

        <i class="bi bi-exclamation-triangle me-2"></i>

        @TempData["ErrorMessage"]

    </div>
}


<div class="content-card">

    <div class="table-responsive">

        <table class="table table-hover align-middle">

            <thead>

                <tr>

                    <th>#</th>

                    <th>
                        Material
                    </th>

                    <th>
                        Category
                    </th>

                    <th>
                        Unit
                    </th>

                    <th>
                        Available
                    </th>

                    <th>
                        Reserved
                    </th>

                    <th>
                        Reorder Level
                    </th>

                    <th>
                        Location
                    </th>

                    <th class="text-end">
                        Action
                    </th>

                </tr>

            </thead>


            <tbody>

                @if (Model != null && Model.Any())
                {
                    int count = 1;

                    foreach (var item in Model)
                    {
                        var lowStock =
                        item.AvailableQuantity <= item.ReorderLevel;

                        <tr>

                            <td>
                                @count
                            </td>


                            <td>

                                <strong>
                                    @item.MaterialName
                                </strong>

                            </td>


                            <td>
                                @item.MaterialCategory
                            </td>


                            <td>
                                @item.Unit
                            </td>


                            <td>

                                @if (lowStock)
                                {
                                    <span class="badge bg-danger">
                                        @item.AvailableQuantity
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success">
                                        @item.AvailableQuantity
                                    </span>
                                }

                            </td>


                            <td>
                                @item.ReservedQuantity
                            </td>


                            <td>
                                @item.ReorderLevel
                            </td>


                            <td>
                                @item.Location
                            </td>


                            <td class="text-end">

                                <a asp-area="Finance"
                                   asp-controller="Inventory"
                                   asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-primary">

                                    <i class="bi bi-journal-text me-1"></i>

                                    View Ledger

                                </a>

                            </td>

                        </tr>

                        count++;
                    }
                }
                else
                {
                    <tr>

                        <td colspan="9"
                            class="text-center py-5">

                            <i class="bi bi-box-seam display-5 text-muted"></i>

                            <h5 class="mt-3">
                                No Inventory Stock Available
                            </h5>

                            <p class="text-muted mb-0">

                                Inventory will be updated after
                                an approved GRN is synchronized.

                            </p>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>