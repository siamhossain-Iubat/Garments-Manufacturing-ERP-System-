@model GManufacturingERP.Models.Entities.InventoryStock

@{
    ViewData["Title"] = "Inventory Details";
    Layout = "~/Areas/Finance/Views/Shared/_FinanceLayout.cshtml";
}

<div class="page-header">

    <div>

        <small>Finance & Logistics / Inventory / Details</small>

        <h1>@Model.MaterialName</h1>

        <p>
            Stock balance and transaction history.
        </p>

    </div>


    <a asp-area="Finance"
       asp-controller="Inventory"
       asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="bi bi-arrow-left me-1"></i>

        Back to Inventory

    </a>

</div>


<!-- ========================================================= -->
<!-- STOCK SUMMARY -->
<!-- ========================================================= -->

<div class="row g-4 mb-4">


    <!-- AVAILABLE -->

    <div class="col-md-3">

        <div class="card border-0 shadow-sm">

            <div class="card-body">

                <small class="text-muted">
                    Available Quantity
                </small>

                <h3 class="mt-2">
                    @Model.AvailableQuantity @Model.Unit
                </h3>

            </div>

        </div>

    </div>


    <!-- RESERVED -->

    <div class="col-md-3">

        <div class="card border-0 shadow-sm">

            <div class="card-body">

                <small class="text-muted">
                    Reserved Quantity
                </small>

                <h3 class="mt-2">
                    @Model.ReservedQuantity @Model.Unit
                </h3>

            </div>

        </div>

    </div>


    <!-- REORDER -->

    <div class="col-md-3">

        <div class="card border-0 shadow-sm">

            <div class="card-body">

                <small class="text-muted">
                    Reorder Level
                </small>

                <h3 class="mt-2">
                    @Model.ReorderLevel @Model.Unit
                </h3>

            </div>

        </div>

    </div>


    <!-- LOCATION -->

    <div class="col-md-3">

        <div class="card border-0 shadow-sm">

            <div class="card-body">

                <small class="text-muted">
                    Location
                </small>

                <h3 class="mt-2">
                    @Model.Location
                </h3>

            </div>

        </div>

    </div>

</div>


<!-- ========================================================= -->
<!-- LOW STOCK WARNING -->
<!-- ========================================================= -->
@if (Model.AvailableQuantity <= Model.ReorderLevel)
{
    <div class="alert alert-warning">

        <i class="bi bi-exclamation-triangle me-2"></i>

        <strong>Low Stock Warning:</strong>

        The available quantity has reached or fallen below
        the reorder level.

    </div>
}


<!-- ========================================================= -->
<!-- TRANSACTION LEDGER -->
<!-- ========================================================= -->

<div class="content-card">

    <div class="card-title mb-3">

        <i class="bi bi-journal-text me-2"></i>

        Stock Transaction Ledger

    </div>


    <div class="table-responsive">

        <table class="table table-hover align-middle">

            <thead>

                <tr>

                    <th>
                        Date
                    </th>

                    <th>
                        Type
                    </th>

                    <th>
                        Reference
                    </th>

                    <th>
                        Quantity In
                    </th>

                    <th>
                        Quantity Out
                    </th>

                    <th>
                        Balance
                    </th>

                    <th>
                        Performed By
                    </th>

                    <th>
                        Remarks
                    </th>

                </tr>

            </thead>


            <tbody>

                @if (Model.Transactions != null &&
                                Model.Transactions.Any())
                {
                    foreach (var transaction in Model.Transactions
                    .OrderByDescending(x => x.TransactionDate))
                    {
                        <tr>

                            <td>

                                @(transaction.TransactionDate
                                                        .ToLocalTime()
                                                        .ToString("dd MMM yyyy HH:mm"))

                    </td>


                            <td>

                                <span class="badge bg-primary">

                                    @transaction.TransactionType

                                </span>

                            </td>


                            <td>

                                @transaction.ReferenceNumber

                            </td>


                            <td>

                        @if (transaction.QuantityIn > 0)
                                {
                                    <span class="text-success fw-semibold">

                                        +@transaction.QuantityIn

                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        0
                                    </span>
                                }

                            </td>


                            <td>

                                @if (transaction.QuantityOut > 0)
                                {
                                    <span class="text-danger fw-semibold">

                                        -@transaction.QuantityOut

                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        0
                                    </span>
                                }

                            </td>


                            <td>

                                <strong>
                                    @transaction.BalanceAfter
                                </strong>

                            </td>


                            <td>

                                @transaction.PerformedBy

                            </td>


                            <td>

                                @transaction.Remarks

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="8"
                            class="text-center py-5">

                            <i class="bi bi-journal-x display-5 text-muted"></i>

                            <h5 class="mt-3">
                                No Transactions Found
                            </h5>

                            <p class="text-muted mb-0">
                                No stock transaction has been recorded yet.
                            </p>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>