@model GManufacturingERP.ViewModels.CreateDispatchViewModel

@{
    ViewData["Title"] = "Create Dispatch";
    Layout = "~/Areas/Finance/Views/Shared/_FinanceLayout.cshtml";
}

<div class="page-header mb-4">

    <small class="text-muted">
        Finance & Logistics / Dispatch / Create
    </small>

    <h1>Create Dispatch</h1>

    <p class="text-muted">
        Create a dispatch record from a shipment.
    </p>

</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <div asp-validation-summary="All"></div>
    </div>
}

<div class="row g-4">

    <div class="col-lg-5">

        <div class="card shadow-sm border-0">

            <div class="card-header bg-white">

                <h5 class="mb-0">
                    <i class="bi bi-box-seam me-2"></i>
                    Shipment Information
                </h5>

            </div>

            <div class="card-body">

                <div class="mb-3">

                    <label class="form-label text-muted">
                        Shipment Number
                    </label>

                    <input class="form-control"
                           value="@Model.ShipmentNumber"
                           readonly />

                </div>

                <div class="mb-3">

                    <label class="form-label text-muted">
                        Product
                    </label>

                    <input class="form-control"
                           value="@Model.ProductName"
                           readonly />

                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label class="form-label text-muted">
                            Shipment Quantity
                        </label>

                        <input class="form-control"
                               value="@Model.ShipmentQuantity.ToString("N2") @Model.Unit"
                               readonly />

                    </div>

                    <div class="col-md-6 mb-3">

                        <label class="form-label text-muted">
                            Shipment Cartons
                        </label>

                        <input class="form-control"
                               value="@Model.ShipmentCartons"
                               readonly />

                    </div>

                </div>

            </div>

        </div>

    </div>

    <div class="col-lg-7">

        <form asp-action="Create" method="post">

            @Html.AntiForgeryToken()

            <input asp-for="ShipmentId" type="hidden" />

            <div class="card shadow-sm border-0">

                <div class="card-header bg-white">

                    <h5 class="mb-0">
                        <i class="bi bi-truck me-2"></i>
                        Dispatch Details
                    </h5>

                </div>

                <div class="card-body">

                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label asp-for="DispatchQuantity"
                                   class="form-label">
                                Dispatch Quantity
                            </label>

                            <div class="input-group">

                                <input asp-for="DispatchQuantity"
                                       class="form-control" />

                                <span class="input-group-text">
                                    @Model.Unit
                                </span>

                            </div>

                            <span asp-validation-for="DispatchQuantity"
                                  class="text-danger"></span>

                        </div>

                        <div class="col-md-6 mb-3">

                            <label asp-for="TotalCartons"
                                   class="form-label">
                                Total Cartons
                            </label>

                            <input asp-for="TotalCartons"
                                   class="form-control" />

                            <span asp-validation-for="TotalCartons"
                                  class="text-danger"></span>

                        </div>

                    </div>

                    <div class="mb-3">

                        <label asp-for="DispatchDate"
                               class="form-label">
                            Dispatch Date
                        </label>

                        <input asp-for="DispatchDate"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="DispatchDate"
                              class="text-danger"></span>

                    </div>

                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label asp-for="TransportName"
                                   class="form-label">
                                Transport / Courier
                            </label>

                            <input asp-for="TransportName"
                                   class="form-control"
                                   placeholder="Transport name" />

                        </div>

                        <div class="col-md-6 mb-3">

                            <label asp-for="VehicleNumber"
                                   class="form-label">
                                Vehicle Number
                            </label>

                            <input asp-for="VehicleNumber"
                                   class="form-control"
                                   placeholder="Vehicle number" />

                        </div>

                    </div>

                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label asp-for="DriverName"
                                   class="form-label">
                                Driver Name
                            </label>

                            <input asp-for="DriverName"
                                   class="form-control"
                                   placeholder="Driver name" />

                        </div>

                        <div class="col-md-6 mb-3">

                            <label asp-for="DriverPhone"
                                   class="form-label">
                                Driver Phone
                            </label>

                            <input asp-for="DriverPhone"
                                   class="form-control"
                                   placeholder="Driver phone" />

                        </div>

                    </div>

                    <div class="mb-3">

                        <label asp-for="Destination"
                               class="form-label">
                            Destination
                        </label>

                        <textarea asp-for="Destination"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Enter destination"></textarea>

                    </div>

                    <div class="mb-3">

                        <label asp-for="Remarks"
                               class="form-label">
                            Remarks
                        </label>

                        <textarea asp-for="Remarks"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Optional remarks"></textarea>

                    </div>

                </div>

                <div class="card-footer bg-white d-flex justify-content-between">

                    <a asp-area="Finance"
                       asp-controller="Shipment"
                       asp-action="Details"
                       asp-route-id="@Model.ShipmentId"
                       class="btn btn-outline-secondary">

                        <i class="bi bi-arrow-left"></i>
                        Back

                    </a>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-check-circle"></i>
                        Create Dispatch

                    </button>

                </div>

            </div>

        </form>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}