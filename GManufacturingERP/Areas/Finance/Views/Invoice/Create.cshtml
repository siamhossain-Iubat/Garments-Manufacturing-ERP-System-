@model GManufacturingERP.ViewModels.CreateInvoiceViewModel

@{
    ViewData["Title"] = "Create Invoice";
    Layout = "~/Areas/Finance/Views/Shared/_FinanceLayout.cshtml";
}

<div class="page-header mb-4">

    <small class="text-muted">
        Finance & Logistics / Invoice / Create
    </small>

    <h1>Create Invoice</h1>

    <p class="text-muted mb-0">
        Create an invoice from a completed delivery.
    </p>

</div>


@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <div asp-validation-summary="All"></div>
    </div>
}


<div class="row g-4">

    <!-- =========================================================
         DELIVERY INFORMATION
         ========================================================= -->

    <div class="col-lg-5">

        <div class="card shadow-sm border-0">

            <div class="card-header bg-white">

                <h5 class="mb-0">
                    <i class="bi bi-box2-heart me-2"></i>
                    Delivery Information
                </h5>

            </div>

            <div class="card-body">

                <!-- Delivery Number -->

                <div class="mb-3">

                    <label class="form-label text-muted">
                        Delivery Number
                    </label>

                    <input type="text"
                           class="form-control"
                           value="@Model.DeliveryNumber"
                           readonly />

                </div>


                <!-- Dispatch Number -->

                <div class="mb-3">

                    <label class="form-label text-muted">
                        Dispatch Number
                    </label>

                    <input type="text"
                           class="form-control"
                           value="@Model.DispatchNumber"
                           readonly />

                </div>


                <!-- Shipment Number -->

                <div class="mb-3">

                    <label class="form-label text-muted">
                        Shipment Number
                    </label>

                    <input type="text"
                           class="form-control"
                           value="@Model.ShipmentNumber"
                           readonly />

                </div>


                <!-- Sales Order -->

                <div class="mb-3">

                    <label class="form-label text-muted">
                        Sales Order
                    </label>

                    <input type="text"
                           class="form-control"
                           value="@Model.SalesOrderNumber"
                           readonly />

                </div>


                <!-- Product -->

                <div class="mb-3">

                    <label class="form-label text-muted">
                        Product
                    </label>

                    <input type="text"
                           class="form-control"
                           value="@Model.ProductName"
                           readonly />

                </div>


                <!-- Quantity + Buyer -->

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label class="form-label text-muted">
                            Quantity
                        </label>

                        <input type="text"
                               class="form-control"
                               value="@Model.Quantity.ToString("N2") @Model.Unit"
                               readonly />

                    </div>


                    <div class="col-md-6 mb-3">

                        <label class="form-label text-muted">
                            Buyer
                        </label>

                        <input type="text"
                               class="form-control"
                               value="@Model.BuyerName"
                               readonly />

                    </div>

                </div>

            </div>

        </div>

    </div>



    <!-- =========================================================
         INVOICE DETAILS
         ========================================================= -->

    <div class="col-lg-7">

        <form asp-action="Create"
              method="post">

            @Html.AntiForgeryToken()


            <!-- Hidden Fields -->

            <input asp-for="DeliveryId"
                   type="hidden" />

            <input asp-for="SalesOrderId"
                   type="hidden" />

            <input asp-for="ProductName"
                   type="hidden" />

            <input asp-for="BuyerName"
                   type="hidden" />


            <div class="card shadow-sm border-0">


                <!-- Header -->

                <div class="card-header bg-white">

                    <h5 class="mb-0">
                        <i class="bi bi-receipt me-2"></i>
                        Invoice Details
                    </h5>

                </div>


                <!-- Body -->

                <div class="card-body">


                    <!-- =================================================
                         BUYER
                         ================================================= -->

                    <div class="mb-3">

                        <label class="form-label">
                            Buyer Name
                        </label>

                        <input type="text"
                               class="form-control"
                               value="@Model.BuyerName"
                               readonly />

                    </div>



                    <!-- =================================================
                         AUTO COMMERCIAL VALUES MESSAGE
                         ================================================= -->

                    <div class="alert alert-success">

                        <i class="bi bi-check-circle me-2"></i>

                        <strong>
                            Commercial values are auto-filled.
                        </strong>

                        <br />

                        Unit Price, Discount and Tax are carried from
                        the accepted quotation through the Sales Order.

                        Finance does not need to enter them again.

                    </div>



                    <!-- =================================================
                         UNIT PRICE + DISCOUNT
                         ================================================= -->

                    <div class="row">


                        <!-- Unit Price -->

                        <div class="col-md-6 mb-3">

                            <label asp-for="UnitPrice"
                                   class="form-label">

                                Unit Price

                            </label>

                            <input asp-for="UnitPrice"
                                   class="form-control"
                                   type="number"
                                   step="0.01"
                                   readonly />

                            <small class="text-muted">
                                From accepted quotation
                            </small>

                        </div>


                        <!-- Discount -->

                        <div class="col-md-6 mb-3">

                            <label asp-for="Discount"
                                   class="form-label">

                                Discount

                            </label>

                            <input asp-for="Discount"
                                   class="form-control"
                                   type="number"
                                   step="0.01"
                                   readonly />

                            <small class="text-muted">
                                From accepted quotation
                            </small>

                        </div>

                    </div>



                    <!-- =================================================
                         TAX / VAT
                         ================================================= -->

                    <div class="mb-3">

                        <label asp-for="Tax"
                               class="form-label">

                            Tax / VAT

                        </label>

                        <input asp-for="Tax"
                               class="form-control"
                               type="number"
                               step="0.01"
                               readonly />

                        <small class="text-muted">
                            From accepted quotation
                        </small>

                    </div>



                    <!-- =================================================
                         INVOICE CALCULATION
                         ================================================= -->

                    <div class="card bg-light border-0 mb-3">

                        <div class="card-body">


                            <h6 class="mb-3">
                                Invoice Calculation
                            </h6>


                            <!-- Quantity -->

                            <div class="d-flex justify-content-between mb-2">

                                <span>
                                    Quantity
                                </span>

                                <strong>
                                    @Model.Quantity.ToString("N2")
                                    @Model.Unit
                                </strong>

                            </div>


                            <!-- Unit Price -->

                            <div class="d-flex justify-content-between mb-2">

                                <span>
                                    Unit Price
                                </span>

                                <strong>
                                    @Model.UnitPrice.ToString("N2")
                                </strong>

                            </div>


                            <!-- Subtotal -->

                            <div class="d-flex justify-content-between mb-2">

                                <span>
                                    Subtotal
                                </span>

                                <strong>
                                    @Model.Subtotal.ToString("N2")
                                </strong>

                            </div>


                            <!-- Discount -->

                            <div class="d-flex justify-content-between mb-2">

                                <span>
                                    Discount
                                </span>

                                <strong class="text-danger">
                                    - @Model.Discount.ToString("N2")
                                </strong>

                            </div>


                            <!-- Tax -->

                            <div class="d-flex justify-content-between mb-2">

                                <span>
                                    Tax / VAT
                                </span>

                                <strong>
                                    @Model.Tax.ToString("N2")
                                </strong>

                            </div>


                            <hr />


                            <!-- Grand Total -->

                            <div class="d-flex justify-content-between mb-2">

                                <strong>
                                    Grand Total
                                </strong>

                                <strong class="fs-5">
                                    @Model.GrandTotal.ToString("N2")
                                </strong>

                            </div>


                            <!-- Advance Paid -->

                            <hr />

                            <div class="d-flex justify-content-between mb-2">

                                <span>
                                    Advance Paid
                                </span>

                                <strong class="text-success">
                                    - @Model.AdvancePaidAmount.ToString("N2")
                                </strong>

                            </div>


                            <!-- Remaining Due -->

                            <div class="d-flex justify-content-between">

                                <strong>
                                    Remaining Due
                                </strong>

                                <strong class="fs-5 text-danger">
                                    @Model.RemainingDue.ToString("N2")
                                </strong>

                            </div>


                        </div>

                    </div>



                    <!-- =================================================
                         INVOICE DATE + DUE DATE
                         ================================================= -->

                    <div class="row">


                        <!-- Invoice Date -->

                        <div class="col-md-6 mb-3">

                            <label asp-for="InvoiceDate"
                                   class="form-label">

                                Invoice Date

                            </label>

                            <input asp-for="InvoiceDate"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="InvoiceDate"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Due Date -->

                        <div class="col-md-6 mb-3">

                            <label asp-for="DueDate"
                                   class="form-label">

                                Due Date

                            </label>

                            <input asp-for="DueDate"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="DueDate"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>



                    <!-- =================================================
                         NOTES
                         ================================================= -->

                    <div class="mb-3">

                        <label asp-for="Notes"
                               class="form-label">

                            Notes

                        </label>

                        <textarea asp-for="Notes"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Optional notes">
                        </textarea>

                    </div>



                    <!-- =================================================
                         INFORMATION
                         ================================================= -->

                    <div class="alert alert-info mb-0">

                        <i class="bi bi-info-circle me-2"></i>

                        The invoice uses the commercial terms already
                        accepted in the quotation.

                        <br />

                        For a partial delivery, discount and tax are
                        allocated according to the delivered quantity.

                    </div>


                </div>



                <!-- Footer -->

                <div class="card-footer bg-white d-flex justify-content-between">


                    <a asp-area="Finance"
                       asp-controller="Delivery"
                       asp-action="Details"
                       asp-route-id="@Model.DeliveryId"
                       class="btn btn-outline-secondary">

                        <i class="bi bi-arrow-left"></i>

                        Back

                    </a>


                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-receipt"></i>

                        Create Invoice

                    </button>


                </div>


            </div>

        </form>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}