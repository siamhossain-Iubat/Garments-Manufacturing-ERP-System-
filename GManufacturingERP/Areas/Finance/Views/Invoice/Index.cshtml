@model IEnumerable<GManufacturingERP.Models.Entities.Invoice>

@{
    ViewData["Title"] = "Invoice Management";
    Layout = "~/Areas/Finance/Views/Shared/_FinanceLayout.cshtml";
}

<div class="page-header mb-4">

    <small class="text-muted">
        Finance & Logistics / Invoice
    </small>

    <h1>Invoice Management</h1>

    <p class="text-muted mb-0">
        Manage customer invoices and outstanding amounts.
    </p>

</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">

        <i class="bi bi-check-circle me-2"></i>

        @TempData["SuccessMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">

        <i class="bi bi-exclamation-triangle me-2"></i>

        @TempData["ErrorMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}

<div class="card shadow-sm border-0">

    <div class="card-header bg-white py-3">

        <h5 class="mb-0">

            <i class="bi bi-receipt me-2"></i>

            Invoice List

        </h5>

    </div>

    <div class="card-body p-0">

        @if (!Model.Any())
        {
            <div class="text-center py-5">

                <i class="bi bi-receipt fs-1 text-muted"></i>

                <h5 class="mt-3">
                    No Invoices Found
                </h5>

                <p class="text-muted mb-0">
                    Invoices will appear here after delivery completion.
                </p>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th>Invoice No.</th>

                            <th>Delivery No.</th>

                            <th>Buyer</th>

                            <th>Product</th>

                            <th>Total</th>

                            <th>Paid</th>

                            <th>Due</th>

                            <th>Status</th>

                            <th class="text-end">
                                Action
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            var badgeClass = item.Status switch
                            {
                                "Draft" => "bg-secondary",
                                "Issued" => "bg-primary",
                                "Partially Paid" => "bg-warning text-dark",
                                "Paid" => "bg-success",
                                "Cancelled" => "bg-danger",
                                _ => "bg-secondary"
                            };

                            <tr>

                                <td>
                                    <strong>
                                        @item.InvoiceNumber
                                    </strong>
                                </td>

                                <td>
                                    @item.Delivery?.DeliveryNumber
                                </td>

                                <td>
                                    @item.BuyerName
                                </td>

                                <td>
                                    @item.ProductName
                                </td>

                                <td>
                                    @item.GrandTotal.ToString("N2")
                                </td>

                                <td>
                                    @item.PaidAmount.ToString("N2")
                                </td>

                                <td>
                                    <strong>
                                        @item.DueAmount.ToString("N2")
                                    </strong>
                                </td>

                                <td>

                                    <span class="badge @badgeClass">
                                        @item.Status
                                    </span>

                                </td>

                                <td class="text-end">

                                    <a asp-area="Finance"
                                       asp-controller="Invoice"
                                       asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-primary">

                                        <i class="bi bi-eye"></i>

                                        Details

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>