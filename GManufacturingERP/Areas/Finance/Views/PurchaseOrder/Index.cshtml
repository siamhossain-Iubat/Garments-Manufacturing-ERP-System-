@model IEnumerable<GManufacturingERP.Models.Entities.PurchaseOrder>

@{
    ViewData["Title"] = "Purchase Orders";

    Layout =
        "~/Areas/Finance/Views/Shared/_FinanceLayout.cshtml";


    var approvedRequisitions =
        ViewBag.ApprovedRequisitions
        as IEnumerable<GManufacturingERP.Models.Entities.PurchaseRequisition>;
}


<!-- ========================================================= -->
<!-- PAGE HEADER -->
<!-- ========================================================= -->

<div class="page-header">

    <div>

        <small>
            Finance & Logistics / Procurement
        </small>

        <h1>
            Purchase Orders
        </h1>

        <p>
            Create and manage supplier purchase orders.
        </p>

    </div>

</div>


<!-- ========================================================= -->
<!-- SUCCESS MESSAGE -->
<!-- ========================================================= -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">

        <i class="bi bi-check-circle me-2"></i>

        @TempData["SuccessMessage"]

    </div>
}


<!-- ========================================================= -->
<!-- ERROR MESSAGE -->
<!-- ========================================================= -->
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">

        <i class="bi bi-exclamation-triangle me-2"></i>

        @TempData["ErrorMessage"]

    </div>
}


<!-- ========================================================= -->
<!-- SECTION 1 -->
<!-- APPROVED PURCHASE REQUISITIONS READY FOR PO -->
<!-- ========================================================= -->

<div class="content-card mb-4">

    <div class="mb-4">

        <h4 class="mb-1">

            Approved Purchase Requisitions — Ready for PO

        </h4>

        <p class="text-muted mb-0">

            Approved requisitions that have not yet been
            converted into Purchase Orders.

        </p>

    </div>


    <div class="table-responsive">

        <table class="table align-middle">

            <thead>

                <tr>

                    <th>
                        PR Number
                    </th>

                    <th>
                        Material
                    </th>

                    <th>
                        Quantity
                    </th>

                    <th>
                        Status
                    </th>

                    <th class="text-end">
                        Action
                    </th>

                </tr>

            </thead>


            <tbody>

                @if (approvedRequisitions != null &&
                                approvedRequisitions.Any())
                {
                    foreach (var pr in approvedRequisitions)
                    {
                        var firstItem =
                        pr.Items?.FirstOrDefault();


                        var materialName =
                        firstItem?.MaterialName
                        ?? "Multiple Materials";


                        var quantity =
                        firstItem != null
                        ? $"{firstItem.RequestedQuantity:N2} {firstItem.Unit}"
                        : "-";


                        var additionalItems =
                        pr.Items != null
                        ? pr.Items.Count - 1
                        : 0;


                        <tr>

                            <!-- PR NUMBER -->

                            <td>

                                <strong>

                                    @pr.RequisitionNumber

                                </strong>

                            </td>


                            <!-- MATERIAL -->

                            <td>

                                @materialName

                                @if (additionalItems > 0)
                                {
                                    <span class="text-muted ms-1">

                                        + @additionalItems more

                                    </span>
                                }

                            </td>


                            <!-- QUANTITY -->

                            <td>

                                @quantity

                            </td>


                            <!-- STATUS -->

                            <td>

                                <span class="badge bg-success">

                                    Approved

                                </span>

                            </td>


                            <!-- ACTION -->

                            <td class="text-end">

                                <a asp-area="Finance"
                                   asp-controller="PurchaseOrder"
                                   asp-action="Create"
                                   asp-route-requisitionId="@pr.Id"
                                   class="btn btn-sm btn-primary">

                                    <i class="bi bi-cart-plus me-1"></i>

                                    Create Purchase Order

                                </a>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="5"
                            class="text-center py-5">

                            <i class="bi bi-check2-circle display-5 text-success"></i>

                            <h5 class="mt-3">

                                No Approved Requisitions Ready for PO

                            </h5>

                            <p class="text-muted mb-0">

                                All approved requisitions have already
                                been converted into Purchase Orders.

                            </p>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>


<!-- ========================================================= -->
<!-- SECTION 2 -->
<!-- EXISTING PURCHASE ORDERS -->
<!-- ========================================================= -->

<div class="content-card">

    <div class="mb-4">

        <h4 class="mb-1">

            Existing Purchase Orders

        </h4>

        <p class="text-muted mb-0">

            View and manage previously created Purchase Orders.

        </p>

    </div>


    <div class="table-responsive">

        <table class="table align-middle">

            <thead>

                <tr>

                    <th>
                        PO Number
                    </th>

                    <th>
                        PR Number
                    </th>

                    <th>
                        Supplier
                    </th>

                    <th>
                        Order Date
                    </th>

                    <th>
                        Expected Delivery
                    </th>

                    <th>
                        Grand Total
                    </th>

                    <th>
                        Status
                    </th>

                    <th class="text-end">
                        Action
                    </th>

                </tr>

            </thead>


            <tbody>

                @if (Model != null &&
                                Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>

                            <!-- PO NUMBER -->

                            <td>

                                <strong>

                                    @item.PurchaseOrderNumber

                                </strong>

                            </td>


                            <!-- PR NUMBER -->

                            <td>

                                @(item.PurchaseRequisition
                                                        ?.RequisitionNumber ?? "-")

                            </td>


                            <!-- SUPPLIER -->

                            <td>

                                @item.SupplierName

                            </td>


                            <!-- ORDER DATE -->

                            <td>

                                @(item.OrderDate.ToString(
                                                        "dd MMM yyyy"))

                            </td>


                            <!-- EXPECTED DELIVERY -->

                            <td>

                                @(item.ExpectedDeliveryDate.ToString(
                                                        "dd MMM yyyy"))

                    </td>


                            <!-- GRAND TOTAL -->

                            <td>

                                @item.GrandTotal.ToString("N2")

                            </td>


                            <!-- STATUS -->

                            <td>

                        @if (item.PurchaseOrderStatus == "Approved")
                                {
                                    <span class="badge bg-success">

                                        Approved

                                    </span>
                                }
                                else if (item.PurchaseOrderStatus == "Submitted")
                                {
                                    <span class="badge bg-info">

                                        Pending Admin Approval

                                    </span>
                                }
                                else if (item.PurchaseOrderStatus == "Rejected")
                                {
                                    <span class="badge bg-danger">

                                        Rejected

                                    </span>
                                }
                                else if (item.PurchaseOrderStatus == "Draft")
                                {
                                    <span class="badge bg-warning text-dark">

                                        Draft

                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">

                                        @item.PurchaseOrderStatus

                                    </span>
                                }

                            </td>


                            <!-- ACTION -->

                            <td class="text-end">

                                <a asp-area="Finance"
                                   asp-controller="PurchaseOrder"
                                   asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-primary">

                                    <i class="bi bi-eye me-1"></i>

                                    View

                                </a>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="8"
                            class="text-center py-5">

                            <i class="bi bi-cart-x display-5 text-muted"></i>

                            <h5 class="mt-3">

                                No Purchase Orders Found

                            </h5>

                            <p class="text-muted mb-0">

                                Approved requisitions can be converted
                                into Purchase Orders.

                            </p>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>