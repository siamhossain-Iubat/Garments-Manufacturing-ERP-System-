@model GManufacturingERP.ViewModels.CreatePurchaseOrderViewModel

@{
    ViewData["Title"] = "Create Purchase Order";
    Layout = "~/Areas/Finance/Views/Shared/_FinanceLayout.cshtml";
}

<!-- Page Header -->
<div class="page-header">

    <div>
        <small>Finance & Logistics / Procurement</small>

        <h1>
            Create Purchase Order
        </h1>

        <p>
            Create a purchase order from the approved requisition.
        </p>
    </div>

    <a asp-area="Finance"
       asp-controller="PurchaseOrder"
       asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="bi bi-arrow-left me-1"></i>

        Back

    </a>

</div>


<!-- Purchase Order Form -->
<form asp-area="Finance"
      asp-controller="PurchaseOrder"
      asp-action="Create"
      method="post">

    @Html.AntiForgeryToken()

    <!-- Hidden Requisition ID -->
    <input asp-for="PurchaseRequisitionId"
           type="hidden" />


    <!-- Validation Summary -->
    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger">
    </div>


    <!-- ===================================================== -->
    <!-- REQUISITION INFORMATION -->
    <!-- ===================================================== -->

    <div class="content-card mb-4">

        <div class="card-title">

            <i class="bi bi-file-earmark-text me-2"></i>

            Requisition Information

        </div>


        <div class="row g-3">

            <!-- Requisition Number -->
            <div class="col-md-6">

                <label asp-for="RequisitionNumber"
                       class="form-label">

                    Requisition Number

                </label>

                <input asp-for="RequisitionNumber"
                       class="form-control"
                       readonly />

            </div>


            <!-- Order Date -->
            <div class="col-md-6">

                <label asp-for="OrderDate"
                       class="form-label">

                    Order Date

                </label>

                <input asp-for="OrderDate"
                       type="date"
                       class="form-control" />

                <span asp-validation-for="OrderDate"
                      class="text-danger">
                </span>

            </div>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- SUPPLIER INFORMATION -->
    <!-- ===================================================== -->

    <div class="content-card mb-4">

        <div class="card-title">

            <i class="bi bi-building me-2"></i>

            Supplier Information

        </div>


        <div class="row g-3">

            <!-- Supplier Name -->
            <div class="col-md-4">

                <label asp-for="SupplierName"
                       class="form-label">

                    Supplier Name

                </label>

                <input asp-for="SupplierName"
                       class="form-control"
                       placeholder="Enter supplier name"
                       autocomplete="off" />

                <span asp-validation-for="SupplierName"
                      class="text-danger">
                </span>

            </div>


            <!-- Supplier Contact -->
            <div class="col-md-4">

                <label asp-for="SupplierContact"
                       class="form-label">

                    Supplier Contact

                </label>

                <input asp-for="SupplierContact"
                       class="form-control"
                       placeholder="Phone or email"
                       autocomplete="off" />

                <span asp-validation-for="SupplierContact"
                      class="text-danger">
                </span>

            </div>


            <!-- Supplier Address -->
            <div class="col-md-4">

                <label asp-for="SupplierAddress"
                       class="form-label">

                    Supplier Address

                </label>

                <input asp-for="SupplierAddress"
                       class="form-control"
                       placeholder="Supplier address"
                       autocomplete="off" />

                <span asp-validation-for="SupplierAddress"
                      class="text-danger">
                </span>

            </div>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- DELIVERY & PAYMENT -->
    <!-- ===================================================== -->

    <div class="content-card mb-4">

        <div class="card-title">

            <i class="bi bi-truck me-2"></i>

            Delivery & Payment

        </div>


        <div class="row g-3">

            <!-- Expected Delivery Date -->
            <div class="col-md-4">

                <label asp-for="ExpectedDeliveryDate"
                       class="form-label">

                    Expected Delivery Date

                </label>

                <input asp-for="ExpectedDeliveryDate"
                       type="date"
                       class="form-control" />

                <span asp-validation-for="ExpectedDeliveryDate"
                      class="text-danger">
                </span>

            </div>


            <!-- Payment Terms -->
            <div class="col-md-4">

                <label asp-for="PaymentTerms"
                       class="form-label">

                    Payment Terms

                </label>

                <select asp-for="PaymentTerms"
                        class="form-select">

                    <option value="">
                        Select Payment Terms
                    </option>

                    <option value="Advance">
                        Advance
                    </option>

                    <option value="15 Days">
                        15 Days
                    </option>

                    <option value="30 Days">
                        30 Days
                    </option>

                    <option value="60 Days">
                        60 Days
                    </option>

                </select>

                <span asp-validation-for="PaymentTerms"
                      class="text-danger">
                </span>

            </div>


            <!-- Delivery Terms -->
            <div class="col-md-4">

                <label asp-for="DeliveryTerms"
                       class="form-label">

                    Delivery Terms

                </label>

                <select asp-for="DeliveryTerms"
                        class="form-select">

                    <option value="">
                        Select Delivery Terms
                    </option>

                    <option value="Factory Delivery">
                        Factory Delivery
                    </option>

                    <option value="Supplier Delivery">
                        Supplier Delivery
                    </option>

                    <option value="Ex-Factory">
                        Ex-Factory
                    </option>

                </select>

                <span asp-validation-for="DeliveryTerms"
                      class="text-danger">
                </span>

            </div>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- ORDER MATERIALS -->
    <!-- ===================================================== -->

    <div class="content-card mb-4">

        <div class="card-title">

            <i class="bi bi-box-seam me-2"></i>

            Order Materials

        </div>


        <div class="table-responsive">

            <table class="table align-middle">

                <thead>

                    <tr>

                        <th>
                            Material
                        </th>

                        <th>
                            Category
                        </th>

                        <th>
                            Unit
                        </th>

                        <th>
                            Quantity
                        </th>

                        <th>
                            Unit Price
                        </th>

                        <th>
                            Remarks
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model.Items != null && Model.Items.Any())
                    {
                        @for (int i = 0; i < Model.Items.Count; i++)
                        {
                            <tr>

                                <!-- Material -->
                                <td>

                                    <input asp-for="Items[i].MaterialName"
                                           class="form-control"
                                           readonly />

                                </td>


                                <!-- Category -->
                                <td>

                                    <input asp-for="Items[i].MaterialCategory"
                                           class="form-control"
                                           readonly />

                                </td>


                                <!-- Unit -->
                                <td>

                                    <input asp-for="Items[i].Unit"
                                           class="form-control"
                                           readonly />

                                </td>


                                <!-- Ordered Quantity -->
                                <td>

                                    <input asp-for="Items[i].OrderedQuantity"
                                           type="number"
                                           step="0.01"
                                           min="0.01"
                                           class="form-control" />

                                    <span asp-validation-for="Items[i].OrderedQuantity"
                                          class="text-danger">
                                    </span>

                                </td>


                                <!-- Unit Price -->
                                <td>

                                    <input asp-for="Items[i].UnitPrice"
                                           type="number"
                                           step="0.01"
                                           min="0"
                                           class="form-control" />

                                    <span asp-validation-for="Items[i].UnitPrice"
                                          class="text-danger">
                                    </span>

                                </td>


                                <!-- Remarks -->
                                <td>

                                    <input asp-for="Items[i].Remarks"
                                           class="form-control"
                                           placeholder="Optional" />

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="6"
                                class="text-center text-muted py-4">

                                <i class="bi bi-inbox fs-4 d-block mb-2"></i>

                                No materials found in this requisition.

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- PURCHASE ORDER REMARKS -->
    <!-- ===================================================== -->

    <div class="content-card mb-4">

        <div class="card-title">

            <i class="bi bi-chat-left-text me-2"></i>

            Purchase Order Remarks

        </div>


        <textarea asp-for="Remarks"
                  class="form-control"
                  rows="3"
                  placeholder="Additional purchase order remarks..."></textarea>

        <span asp-validation-for="Remarks"
              class="text-danger">
        </span>

    </div>


    <!-- ===================================================== -->
    <!-- ACTION BUTTONS -->
    <!-- ===================================================== -->

    <div class="d-flex justify-content-end gap-2">

        <!-- Cancel -->
        <a asp-area="Finance"
           asp-controller="PurchaseOrder"
           asp-action="Index"
           class="btn btn-light border">

            <i class="bi bi-x-circle me-1"></i>

            Cancel

        </a>


        <!-- Save Draft -->
        <button type="submit"
                class="btn btn-primary">

            <i class="bi bi-save me-1"></i>

            Save Draft PO

        </button>

    </div>

</form>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}