@model IEnumerable<GManufacturingERP.Models.Entities.GoodsReceipt>

@using GManufacturingERP.Models.Entities

@{
    ViewData["Title"] = "Goods Receipts";
    Layout = "~/Areas/Finance/Views/Shared/_FinanceLayout.cshtml";

    var approvedPurchaseOrders =
        ViewBag.ApprovedPurchaseOrders
        as IEnumerable<PurchaseOrder>;
}

<div class="page-header">

    <div>

        <small>Finance & Logistics / Receiving</small>

        <h1>Goods Receipts</h1>

        <p>
            Manage received materials against approved purchase orders.
        </p>

    </div>

</div>


@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">

        <i class="bi bi-check-circle me-2"></i>

        @TempData["SuccessMessage"]

    </div>
}


@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">

        <i class="bi bi-exclamation-triangle me-2"></i>

        @TempData["ErrorMessage"]

    </div>
}


<!-- ========================================================= -->
<!-- APPROVED PURCHASE ORDERS READY FOR GRN -->
<!-- ========================================================= -->

<div class="content-card mb-4">

    <div class="mb-4">

        <div class="card-title mb-2">

            <i class="bi bi-cart-check me-2"></i>

            Approved Purchase Orders — Ready for GRN

        </div>

        <p class="text-muted mb-0">

            Approved Purchase Orders that are ready for material receiving.

        </p>

    </div>


    <div class="table-responsive">

        <table class="table align-middle">

            <thead>

                <tr>

                    <th>
                        PO Number
                    </th>

                    <th>
                        Supplier
                    </th>

                    <th>
                        Order Date
                    </th>

                    <th>
                        Expected Delivery
                    </th>

                    <th>
                        Status
                    </th>

                    <th class="text-end">
                        Action
                    </th>

                </tr>

            </thead>


            <tbody>

                @if (approvedPurchaseOrders != null &&
                                approvedPurchaseOrders.Any())
                {
                    foreach (var po in approvedPurchaseOrders)
                    {
                        <tr>

                            <td>

                                <strong>
                                    @po.PurchaseOrderNumber
                                </strong>

                            </td>


                            <td>
                                @po.SupplierName
                            </td>


                            <td>

                                @(po.OrderDate.ToString(
                                                        "dd MMM yyyy"))

                            </td>


                            <td>

                                @(po.ExpectedDeliveryDate.ToString(
                                                        "dd MMM yyyy"))

                    </td>


                            <td>

                                <span class="badge bg-success">
                                    Approved
                                </span>

                            </td>


                            <td class="text-end">

                                <a asp-area="Finance"
                                   asp-controller="GoodsReceipt"
                                   asp-action="Create"
                                   asp-route-purchaseOrderId="@po.Id"
                                   class="btn btn-sm btn-primary">

                                    <i class="bi bi-box-seam me-1"></i>

                                    Create GRN

                                </a>

                            </td>

                        </tr>
                                }
                }
                else
                {
                    <tr>

                        <td colspan="6"
                            class="text-center py-5">

                            <i class="bi bi-cart-x display-5 text-muted"></i>

                            <h5 class="mt-3">
                                No Approved Purchase Orders Ready for GRN
                            </h5>

                            <p class="text-muted mb-0">

                                All approved Purchase Orders have already
                                been received or no approved PO is available.

                            </p>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>


<!-- ========================================================= -->
<!-- EXISTING GOODS RECEIPTS -->
<!-- ========================================================= -->

<div class="content-card">

    <div class="mb-4">

        <div class="card-title mb-2">

            <i class="bi bi-box-seam me-2"></i>

            Existing Goods Receipts

        </div>

        <p class="text-muted mb-0">

            View and manage previously created Goods Receipts.

        </p>

    </div>


    <div class="table-responsive">

        <table class="table align-middle">

            <thead>

                <tr>

                    <th>
                        GRN Number
                    </th>

                    <th>
                        PO Number
                    </th>

                    <th>
                        Received By
                    </th>

                    <th>
                        Receipt Date
                    </th>

                    <th>
                        Status
                    </th>

                    <th class="text-end">
                        Action
                    </th>

                </tr>

            </thead>


            <tbody>

                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>

                            <td>

                                <strong>
                                    @item.GRNNumber
                                </strong>

                            </td>


                            <td>

                                @(item.PurchaseOrder
                                                        ?.PurchaseOrderNumber ?? "-")

                            </td>


                            <td>
                                @item.ReceivedBy
                            </td>


                            <td>

                                @(item.ReceiptDate.ToString(
                                                        "dd MMM yyyy"))

                    </td>


                            <td>

                        @if (item.ReceiptStatus == "Draft")
                                {
                                    <span class="badge bg-warning text-dark">
                                        Draft
                                    </span>
                                }
                                else if (item.ReceiptStatus == "Submitted")
                                {
                                    <span class="badge bg-info">
                                        Pending Approval
                                    </span>
                                }
                                else if (item.ReceiptStatus == "Approved")
                                {
                                    <span class="badge bg-success">
                                        Approved
                                    </span>
                                }
                                else if (item.ReceiptStatus == "Rejected")
                                {
                                    <span class="badge bg-danger">
                                        Rejected
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @item.ReceiptStatus
                                    </span>
                                }

                            </td>


                            <td class="text-end">

                                <a asp-area="Finance"
                                   asp-controller="GoodsReceipt"
                                   asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-primary">

                                    <i class="bi bi-eye me-1"></i>

                                    View

                                </a>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="6"
                            class="text-center py-5">

                            <i class="bi bi-box-seam display-5 text-muted"></i>

                            <h5 class="mt-3">
                                No Goods Receipts Found
                            </h5>

                            <p class="text-muted mb-0">

                                Create a GRN from an approved Purchase Order.

                            </p>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>