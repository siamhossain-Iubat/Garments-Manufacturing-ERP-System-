@model GManufacturingERP.Models.Entities.GoodsReceipt

@{
    ViewData["Title"] = "Goods Receipt Details";
    Layout = "~/Areas/Finance/Views/Shared/_FinanceLayout.cshtml";
}

<div class="page-header">

    <div>

        <small>Finance & Logistics / Receiving</small>

        <h1>Goods Receipt Details</h1>

        <p>
            Review received and accepted materials.
        </p>

    </div>


    <a asp-area="Finance"
       asp-controller="GoodsReceipt"
       asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="bi bi-arrow-left me-1"></i>

        Back

    </a>

</div>


@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">

        <i class="bi bi-check-circle me-2"></i>

        @TempData["SuccessMessage"]

    </div>
}


@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">

        <i class="bi bi-exclamation-triangle me-2"></i>

        @TempData["ErrorMessage"]

    </div>
}


<!-- ========================================================= -->
<!-- GRN INFORMATION -->
<!-- ========================================================= -->

<div class="content-card mb-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <div class="card-title mb-0">

            <i class="bi bi-box-seam me-2"></i>

            @Model.GRNNumber

        </div>


        @if (Model.ReceiptStatus == "Draft")
        {
            <span class="badge bg-warning text-dark">
                Draft
            </span>
        }
        else if (Model.ReceiptStatus == "Submitted")
        {
            <span class="badge bg-info">
                Pending Admin Approval
            </span>
        }
        else if (Model.ReceiptStatus == "Approved")
        {
            <span class="badge bg-success">
                Approved
            </span>
        }
        else if (Model.ReceiptStatus == "Rejected")
        {
            <span class="badge bg-danger">
                Rejected
            </span>
        }
        else
        {
            <span class="badge bg-secondary">
                @Model.ReceiptStatus
            </span>
        }

    </div>


    <div class="row g-3">


        <div class="col-md-4">

            <small class="text-muted">
                Purchase Order
            </small>

            <div class="fw-semibold">

                @(Model.PurchaseOrder
                                ?.PurchaseOrderNumber ?? "-")

            </div>

        </div>


        <div class="col-md-4">

            <small class="text-muted">
                Receipt Date
            </small>

            <div class="fw-semibold">

                @(Model.ReceiptDate.ToString(
                                "dd MMM yyyy"))

            </div>

        </div>


        <div class="col-md-4">

            <small class="text-muted">
                Received By
            </small>

            <div class="fw-semibold">

                @Model.ReceivedBy

            </div>

        </div>


        <div class="col-md-4">

            <small class="text-muted">
                Delivery Challan
            </small>

            <div class="fw-semibold">

                @(string.IsNullOrWhiteSpace(
                                Model.DeliveryChallanNumber)
                                ? "-"
                                : Model.DeliveryChallanNumber)

            </div>

        </div>


        <div class="col-md-4">

            <small class="text-muted">
                Created At
            </small>

            <div class="fw-semibold">

                @(Model.CreatedAt
                                .ToLocalTime()
                                .ToString("dd MMM yyyy"))

            </div>

        </div>

    </div>


    @if (!string.IsNullOrWhiteSpace(Model.Remarks))
    {
        <div class="mt-3">

            <small class="text-muted">
                Remarks
            </small>

            <p class="mb-0">
                @Model.Remarks
            </p>

        </div>
    }

</div>


<!-- ========================================================= -->
<!-- MATERIAL RECEIPT SUMMARY -->
<!-- ========================================================= -->

<div class="content-card mb-4">

    <div class="card-title mb-3">

        <i class="bi bi-box-seam me-2"></i>

        Material Receipt Summary

    </div>


    <div class="table-responsive">

        <table class="table align-middle">

            <thead>

                <tr>

                    <th>
                        Material
                    </th>

                    <th>
                        Category
                    </th>

                    <th>
                        Unit
                    </th>

                    <th>
                        Ordered
                    </th>

                    <th>
                        Received
                    </th>

                    <th>
                        Accepted
                    </th>

                    <th>
                        Rejected
                    </th>

                    <th>
                        Remarks
                    </th>

                </tr>

            </thead>


            <tbody>

                @foreach (var item in Model.Items)
                {
                    <tr>

                        <td>
                            @item.MaterialName
                        </td>

                        <td>
                            @item.MaterialCategory
                        </td>

                        <td>
                            @item.Unit
                        </td>

                        <td>
                            @item.OrderedQuantity
                        </td>

                        <td>
                            @item.ReceivedQuantity
                        </td>

                        <td>

                            <span class="text-success fw-semibold">

                                @item.AcceptedQuantity

                            </span>

                        </td>

                        <td>

                            <span class="text-danger fw-semibold">

                                @item.RejectedQuantity

                            </span>

                        </td>

                        <td>
                            @item.Remarks
                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>


<!-- ========================================================= -->
<!-- ACTIONS -->
<!-- ========================================================= -->

<div class="d-flex justify-content-end gap-2">


    <!-- DRAFT → SUBMIT -->
    @if (Model.ReceiptStatus == "Draft")
    {
        <form asp-area="Finance"
              asp-controller="GoodsReceipt"
              asp-action="Submit"
              asp-route-id="@Model.Id"
              method="post">

            @Html.AntiForgeryToken()

            <button type="submit"
                    class="btn btn-primary">

                <i class="bi bi-send me-1"></i>

                Submit for Admin Approval

            </button>

        </form>
    }


    <!-- SUBMITTED -->
    @if (Model.ReceiptStatus == "Submitted")
    {
        <div class="alert alert-info mb-0">

            <i class="bi bi-hourglass-split me-2"></i>

            This GRN is waiting for Admin approval.

        </div>
    }


    <!-- APPROVED → SYNC INVENTORY -->
    @if (Model.ReceiptStatus == "Approved")
    {
        <form asp-area="Finance"
              asp-controller="GoodsReceipt"
              asp-action="SyncInventory"
              asp-route-id="@Model.Id"
              method="post">

            @Html.AntiForgeryToken()

            <button type="submit"
                    class="btn btn-primary"
                    onclick="return confirm('Sync this approved GRN with inventory stock?');">

                <i class="bi bi-arrow-repeat me-1"></i>

                Sync Inventory

            </button>

        </form>
    }


    <!-- REJECTED -->
    @if (Model.ReceiptStatus == "Rejected")
    {
        <div class="alert alert-danger mb-0">

            <i class="bi bi-x-circle me-2"></i>

            This GRN was rejected by Admin.

        </div>
    }

</div>