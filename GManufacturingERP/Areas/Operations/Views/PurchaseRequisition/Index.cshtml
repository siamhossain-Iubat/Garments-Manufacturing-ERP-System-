@model IEnumerable<GManufacturingERP.Models.Entities.PurchaseRequisition>

@{
    ViewData["Title"] = "Purchase Requisitions";
    Layout = "~/Areas/Operations/Views/Shared/_OperationsLayout.cshtml";
}

<div class="page-header">
    <div>
        <small>Operations / Procurement</small>
        <h1>Purchase Requisitions</h1>
        <p>Manage material purchase requests generated from MRP.</p>
    </div>

    <a asp-area="Operations"
       asp-controller="PurchaseRequisition"
       asp-action="SelectMRP"
       class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i>
        New Requisition
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        <i class="bi bi-check-circle me-2"></i>
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle me-2"></i>
        @TempData["ErrorMessage"]
    </div>
}

<div class="content-card">
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Requisition No.</th>
                    <th>MRP No.</th>
                    <th>Required Date</th>
                    <th>Priority</th>
                    <th>Status</th>
                    <th>Created At</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <strong>@item.RequisitionNumber</strong>
                            </td>

                            <td>
                                @item.MaterialRequirementPlan?.MRPNumber
                            </td>

                            <td>
                                @item.RequiredDate.ToString("dd MMM yyyy")
                            </td>

                            <td>
                                @if (item.Priority == "High")
                                {
                                    <span class="badge bg-danger">High</span>
                                }
                                else if (item.Priority == "Urgent")
                                {
                                    <span class="badge bg-dark">Urgent</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @item.Priority
                                    </span>
                                }
                            </td>

                            <td>
                                @if (item.RequisitionStatus == "Approved")
                                {
                                    <span class="badge bg-success">
                                        Approved
                                    </span>
                                }
                                else if (item.RequisitionStatus == "Submitted")
                                {
                                    <span class="badge bg-info">
                                        Submitted
                                    </span>
                                }
                                else if (item.RequisitionStatus == "Rejected")
                                {
                                    <span class="badge bg-danger">
                                        Rejected
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        @item.RequisitionStatus
                                    </span>
                                }
                            </td>

                            <td>
                                @(item.CreatedAt.ToLocalTime()
                                .ToString("dd MMM yyyy"))
                            </td>

                            <td class="text-end">
                                <a asp-area="Operations"
                                   asp-controller="PurchaseRequisition"
                                   asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye"></i>
                                    View
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5">
                            <i class="bi bi-file-earmark-text display-5 text-muted"></i>
                            <h5 class="mt-3">No Purchase Requisitions Found</h5>
                            <p class="text-muted">
                                Create a requisition from an approved MRP.
                            </p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>