@model IEnumerable<GManufacturingERP.Models.Entities.ProductionMonitoring>

@{
    ViewData["Title"] = "Production Monitoring";
    Layout = "~/Areas/Operations/Views/Shared/_OperationsLayout.cshtml";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <small>Operations / Production</small>
        <h1>Production Monitoring</h1>
        <p>Monitor production progress and output.</p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i>
        New Production Monitoring
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body">

        <div class="table-responsive">
            <table class="table table-hover align-middle">

                <thead>
                    <tr>
                        <th>#</th>
                        <th>Monitoring No.</th>
                        <th>Production Reference</th>
                        <th>Product</th>
                        <th>Planned</th>
                        <th>Produced</th>
                        <th>Rejected</th>
                        <th>Remaining</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="10"
                                class="text-center text-muted">
                                No production monitoring records found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        int count = 1;

                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@count</td>

                                <td>
                                    <strong>@item.MonitoringNumber</strong>
                                </td>

                                <td>@item.ProductionReference</td>

                                <td>@item.ProductName</td>

                                <td>@item.PlannedQuantity @item.Unit</td>

                                <td class="text-success">
                                    @item.ProducedQuantity @item.Unit
                                </td>

                                <td class="text-danger">
                                    @item.RejectedQuantity @item.Unit
                                </td>

                                <td>
                                    @item.RemainingQuantity @item.Unit
                                </td>

                                <td>
                                    <span class="badge
                                                @(item.Status == "Completed"
                                                                                      ? "bg-success"
                                                                                      : item.Status == "In Progress"
                                                                                          ? "bg-warning text-dark"
                                                                                          : "bg-secondary")">
                                @item.Status
                            </span>
                        </td>

                                <td>
                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Details
                                    </a>
                                </td>
                            </tr>

                                        count++;
                        }
                    }
                </tbody>

            </table>
        </div>

    </div>
</div>