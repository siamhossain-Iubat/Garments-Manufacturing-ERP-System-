@using Microsoft.AspNetCore.Identity
@using GManufacturingERP.Models.Entities
@inject UserManager<ApplicationUser> UserManager

@{
    var currentUser = await UserManager.GetUserAsync(User);

    var fullName = currentUser?.FullName
        ?? User.Identity?.Name
        ?? "Operations Manager";

    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - GManufacturing ERP</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <style>
        :root {
            --navy-950: #071426;
            --navy-900: #0b1f3a;
            --navy-800: #12345b;
            --blue-600: #2563eb;
            --blue-700: #1d4ed8;
            --light-bg: #f5f7fb;
            --border-color: #e5eaf1;
            --text-dark: #10233f;
            --text-muted: #718096;
        }

        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            min-height: 100%;
        }

        body {
            font-family: "Segoe UI", Arial, sans-serif;
            background: var(--light-bg);
            color: var(--text-dark);
        }

        /* =========================
                   MAIN WRAPPER
                ========================= */

        .operations-wrapper {
            display: flex;
            min-height: 100vh;
        }

        /* =========================
                   SIDEBAR
                ========================= */

        .operations-sidebar {
            width: 280px;
            min-width: 280px;
            background: var(--navy-950);
            color: white;
            position: fixed;
            inset: 0 auto 0 0;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
            z-index: 1000;
        }

        .brand-section {
            padding: 28px 24px;
            border-bottom: 1px solid rgba(255,255,255,0.10);
            flex-shrink: 0;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            color: white;
            text-decoration: none;
            font-size: 23px;
            font-weight: 700;
        }

            .brand i {
                color: #60a5fa;
                font-size: 30px;
            }

            .brand:hover {
                color: white;
            }

        .role-section {
            padding: 22px 24px 10px;
            flex-shrink: 0;
        }

        .role-title {
            color: #93c5fd;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .role-name {
            color: white;
            font-size: 15px;
            font-weight: 600;
            margin-top: 4px;
        }

        .sidebar-menu {
            padding: 15px 14px;
            flex: 1;
        }

        .menu-label {
            color: #64748b;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            padding: 15px 14px 8px;
        }

        .menu-item {
            display: flex;
            align-items: center;
            gap: 13px;
            color: #cbd5e1;
            text-decoration: none;
            padding: 13px 15px;
            border-radius: 10px;
            margin-bottom: 5px;
            transition: 0.2s ease;
            font-size: 15px;
            font-weight: 500;
        }

            .menu-item i {
                width: 22px;
                min-width: 22px;
                font-size: 18px;
                text-align: center;
            }

            .menu-item:hover {
                background: rgba(37, 99, 235, 0.18);
                color: white;
            }

            .menu-item.active {
                background: var(--blue-600);
                color: white;
                box-shadow: 0 5px 15px rgba(37, 99, 235, 0.20);
            }

            .menu-item.disabled {
                opacity: 0.55;
                cursor: not-allowed;
            }

        /* =========================
                   SIDEBAR FOOTER
                ========================= */

        .sidebar-footer {
            padding: 18px 20px;
            border-top: 1px solid rgba(255,255,255,0.10);
            background: var(--navy-950);
            flex-shrink: 0;
        }

        .user-box {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .user-icon {
            width: 40px;
            height: 40px;
            min-width: 40px;
            border-radius: 50%;
            background: #1e3a5f;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #93c5fd;
        }

        .user-info {
            min-width: 0;
            overflow: hidden;
        }

        .user-name {
            color: white;
            font-size: 14px;
            font-weight: 600;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .user-role {
            color: #94a3b8;
            font-size: 12px;
        }

        /* =========================
                   MAIN CONTENT
                ========================= */

        .operations-main {
            margin-left: 280px;
            width: calc(100% - 280px);
            min-height: 100vh;
        }

        .topbar {
            height: 96px;
            background: white;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 35px;
        }

        .topbar-title {
            font-size: 22px;
            font-weight: 700;
            color: var(--text-dark);
            margin: 0;
        }

        .topbar-subtitle {
            font-size: 14px;
            color: var(--text-muted);
            margin-top: 3px;
        }

        .logout-btn {
            border: 1px solid #dc3545;
            background: white;
            color: #dc3545;
            padding: 9px 17px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 600;
            transition: 0.2s ease;
        }

            .logout-btn:hover {
                background: #dc3545;
                color: white;
            }

        .content-area {
            padding: 38px 42px 50px;
        }

        /* =========================
                   PAGE HEADER
                ========================= */

        .page-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 30px;
        }

            .page-header small {
                color: var(--text-muted);
                font-weight: 600;
            }

            .page-header h1 {
                margin: 5px 0;
                font-size: 34px;
                font-weight: 700;
            }

            .page-header p {
                margin: 0;
                color: var(--text-muted);
                font-size: 16px;
            }

        /* =========================
                   CARDS
                ========================= */

        .content-card,
        .dashboard-card {
            background: white;
            border: 1px solid var(--border-color);
            border-radius: 18px;
            box-shadow: 0 5px 20px rgba(15, 23, 42, 0.04);
            overflow: hidden;
        }

        .content-card {
            padding: 24px;
        }

        .dashboard-card .card-header {
            background: white;
            border-bottom: 1px solid var(--border-color);
            padding: 20px 24px;
        }

        .dashboard-card .card-body {
            padding: 24px;
        }

        .dashboard-card h5 {
            color: var(--text-dark);
            font-weight: 700;
        }

        .card-title {
            color: var(--text-dark);
            font-size: 18px;
            font-weight: 700;
            margin-bottom: 20px;
        }

        /* =========================
                   DETAILS
                ========================= */

        .details-label {
            display: block;
            color: var(--text-muted);
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 5px;
        }

        .details-value {
            color: var(--text-dark);
            font-size: 16px;
            font-weight: 600;
        }

        /* =========================
                   TABLE
                ========================= */

        .table {
            margin-bottom: 0;
        }

            .table thead th {
                background: #f8fafc;
                color: #475569;
                font-size: 13px;
                font-weight: 700;
                border-bottom: 1px solid var(--border-color);
                padding: 14px 12px;
                white-space: nowrap;
            }

            .table tbody td {
                padding: 15px 12px;
                color: #475569;
                vertical-align: middle;
            }

            .table tbody tr:hover {
                background: #f8fafc;
            }

        /* =========================
                   EMPTY STATE
                ========================= */

        .empty-state {
            text-align: center;
            padding: 55px 20px;
            color: var(--text-muted);
        }

            .empty-state i {
                font-size: 48px;
                color: #94a3b8;
                margin-bottom: 15px;
            }

            .empty-state h5 {
                color: var(--text-dark);
                margin-bottom: 8px;
            }

        /* =========================
                   BUTTONS
                ========================= */

        .btn-primary {
            background: var(--blue-600);
            border-color: var(--blue-600);
        }

            .btn-primary:hover {
                background: var(--blue-700);
                border-color: var(--blue-700);
            }

        /* =========================
                   RESPONSIVE
                ========================= */

        @@media (max-width: 1200px) {
            .operations-sidebar {
                width: 245px;
                min-width: 245px;
            }

            .operations-main {
                margin-left: 245px;
                width: calc(100% - 245px);
            }

            .content-area {
                padding: 30px 25px 40px;
            }
        }

        @@media (max-width: 992px) {
            .operations-sidebar {
                width: 220px;
                min-width: 220px;
            }

            .operations-main {
                margin-left: 220px;
                width: calc(100% - 220px);
            }

            .topbar {
                padding: 0 25px;
            }

            .page-header h1 {
                font-size: 28px;
            }
        }

        @@media (max-width: 768px) {
            .operations-wrapper {
                display: block;
            }

            .operations-sidebar {
                position: relative;
                width: 100%;
                min-width: 100%;
                min-height: auto;
                max-height: none;
            }

            .operations-main {
                margin-left: 0;
                width: 100%;
            }

            .sidebar-menu {
                padding-bottom: 10px;
            }

            .sidebar-footer {
                position: relative;
            }

            .topbar {
                height: auto;
                min-height: 85px;
                padding: 20px;
                gap: 15px;
            }

            .topbar-title {
                font-size: 19px;
            }

            .logout-btn {
                padding: 8px 12px;
                font-size: 13px;
            }

            .content-area {
                padding: 25px 18px 35px;
            }

            .page-header {
                align-items: flex-start;
                flex-direction: column;
                margin-bottom: 22px;
            }

                .page-header h1 {
                    font-size: 27px;
                }

                .page-header p {
                    font-size: 14px;
                }

            .content-card {
                padding: 18px;
            }

            .table-responsive {
                overflow-x: auto;
            }
        }

        @@media (max-width: 480px) {
            .brand-section {
                padding: 22px 18px;
            }

            .brand {
                font-size: 20px;
            }

            .role-section {
                padding: 18px 18px 8px;
            }

            .sidebar-menu {
                padding-left: 10px;
                padding-right: 10px;
            }

            .topbar {
                align-items: flex-start;
                flex-direction: column;
            }

            .content-area {
                padding: 20px 12px 30px;
            }

            .page-header h1 {
                font-size: 24px;
            }
        }
    </style>
</head>

<body>

    <div class="operations-wrapper">

        <!-- SIDEBAR -->
        <aside class="operations-sidebar">

            <div class="brand-section">
                <a asp-area="Operations"
                   asp-controller="Dashboard"
                   asp-action="Index"
                   class="brand">

                    <i class="bi bi-buildings-fill"></i>
                    <span>GManufacturing</span>
                </a>
            </div>

            <div class="role-section">
                <div class="role-title">
                    Operations Department
                </div>

                <div class="role-name">
                    Operations Manager
                </div>
            </div>

            <nav class="sidebar-menu">

                <div class="menu-label">
                    Main Menu
                </div>

                <a asp-area="Operations"
                   asp-controller="Dashboard"
                   asp-action="Index"
                   class="menu-item @(currentController == "Dashboard" ? "active" : "")">

                    <i class="bi bi-grid-1x2-fill"></i>
                    <span>Dashboard</span>
                </a>

                <a asp-area="Operations"
                   asp-controller="Production"
                   asp-action="Index"
                   class="menu-item @(currentController == "Production" && currentAction == "Index" ? "active" : "")">

                    <i class="bi bi-clipboard2-check-fill"></i>
                    <span>Production Plans</span>
                </a>

                <a asp-area="Operations"
                   asp-controller="Production"
                   asp-action="ApprovedOrders"
                   class="menu-item @(currentController == "Production" && currentAction == "ApprovedOrders" ? "active" : "")">

                    <i class="bi bi-check2-square"></i>
                    <span>Approved Orders</span>
                </a>

                <div class="menu-label">
                    Manufacturing
                </div>

                <a asp-area="Operations"
                   asp-controller="MRP"
                   asp-action="Index"
                   class="menu-item @(currentController == "MRP" ? "active" : "")">

                    <i class="bi bi-box-seam-fill"></i>
                    <span>Material Planning</span>
                </a>

                <a asp-area="Operations"
                   asp-controller="PurchaseRequisition"
                   asp-action="Index"
                   class="menu-item @(currentController == "PurchaseRequisition" ? "active" : "")">

                    <i class="bi bi-file-earmark-text"></i>
                    <span>Purchase Requisitions</span>
                </a>

            

     
                <a asp-area="Operations"
                   asp-controller="Inventory"
                   asp-action="Index"
                   class="menu-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Inventory" ? "active" : "")">

                    <i class="bi bi-box-seam"></i>

                    <span>Inventory</span>

                </a>
                <a asp-area="Operations"
                   asp-controller="MaterialIssue"
                   asp-action="Index"
                   class="menu-item">
                    <i class="bi bi-arrow-up-right-square"></i>
                    <span>Material Issue</span>
                </a>
                <a asp-area="Operations"
                   asp-controller="ProductionMonitoring"
                   asp-action="Index"
                   class="menu-item">
                    <i class="bi bi-gear-wide-connected"></i>
                    <span>Production Monitoring</span>
                </a>

                <a asp-area="Operations"
                   asp-controller="QualityControl"
                   asp-action="Index"
                   class="menu-item">
                    <i class="bi bi-clipboard-check"></i>
                    <span>Quality Control</span>
                </a>
                <a asp-area="Operations"
                   asp-controller="FinishedGoods"
                   asp-action="Index"
                   class="menu-item">
                    <i class="bi bi-box-seam"></i>
                    <span>Finished Goods</span>
                </a>

                <a href="#"
                   class="menu-item disabled">

                    <i class="bi bi-bar-chart-line-fill"></i>
                    <span>Production Reports</span>
                </a>

            </nav>

            <div class="sidebar-footer">

                <div class="user-box">

                    <div class="user-icon">
                        <i class="bi bi-person-fill"></i>
                    </div>

                    <div class="user-info">

                        <div class="user-name">
                            @fullName
                        </div>

                        <div class="user-role">
                            Operations Manager
                        </div>

                    </div>

                </div>

            </div>

        </aside>

        <!-- MAIN CONTENT -->
        <main class="operations-main">

            <header class="topbar">

                <div>
                    <h2 class="topbar-title">
                        Operations Manager
                    </h2>

                    <div class="topbar-subtitle">
                        GManufacturing ERP
                    </div>
                </div>

                <form asp-area=""
                      asp-controller="Account"
                      asp-action="Logout"
                      method="post"
                      class="d-inline">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-link nav-link"
                            style="text-decoration: none;">

                        <i class="bi bi-box-arrow-right me-2"></i>
                        Logout

                    </button>

                </form>

            </header>

            <section class="content-area">
                @RenderBody()
            </section>

        </main>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>