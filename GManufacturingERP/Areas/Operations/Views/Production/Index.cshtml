@model IEnumerable<GManufacturingERP.Models.Entities.ProductionPlan>

@{
    ViewData["Title"] = "Production Plans";
    Layout = "~/Areas/Operations/Views/Shared/_OperationsLayout.cshtml";
}

<div class="page-header">

    <div>
        <small>Operations Manager</small>
        <h1>Production Plans</h1>
        <p>Manage manufacturing production planning.</p>
    </div>

    <a asp-area="Operations"
       asp-controller="Production"
       asp-action="ApprovedOrders"
       class="btn btn-primary">
        <i class="bi bi-plus-circle"></i>
        Create Production Plan
    </a>

</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        <i class="bi bi-check-circle-fill"></i>
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle-fill"></i>
        @TempData["ErrorMessage"]
    </div>
}

<div class="card dashboard-card">

    <div class="card-header d-flex justify-content-between align-items-center">

        <h5 class="mb-0">
            <i class="bi bi-clipboard2-check-fill"></i>
            All Production Plans
        </h5>

        <span class="text-muted">
            Total: @Model.Count()
        </span>

    </div>

    <div class="card-body">

        @if (!Model.Any())
        {
            <div class="empty-state">

                <i class="bi bi-clipboard2-x"></i>

                <h5>No Production Plans Found</h5>

                <p>
                    Create a plan from an approved sales order.
                </p>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table align-middle">

                    <thead>
                        <tr>
                            <th>Plan Number</th>
                            <th>Order Number</th>
                            <th>Buyer Company</th>
                            <th>Product</th>
                            <th>Quantity</th>
                            <th>Start Date</th>
                            <th>Completion Date</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var plan in Model)
                        {
                            <tr>

                                <td>
                                    <strong>@plan.PlanNumber</strong>
                                </td>

                                <td>
                                    @plan.SalesOrder?.OrderNumber
                                </td>

                                <td>
                                    @plan.BuyerCompany
                                </td>

                                <td>
                                    @plan.ProductDescription
                                </td>

                                <td>
                                    @plan.PlannedQuantity Pieces
                                </td>

                                <td>
                                    @plan.PlannedStartDate.ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    @plan.ExpectedCompletionDate.ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    @if (plan.ProductionStatus == "PendingApproval")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Pending Approval
                                        </span>
                                    }
                                    else if (plan.ProductionStatus == "Planned")
                                    {
                                        <span class="badge bg-success">
                                            Approved / Planned
                                        </span>
                                    }
                                    else if (plan.ProductionStatus == "Rejected")
                                    {
                                        <span class="badge bg-danger">
                                            Rejected
                                        </span>
                                    }
                                    else if (plan.ProductionStatus == "InProgress")
                                    {
                                        <span class="badge bg-primary">
                                            In Progress
                                        </span>
                                    }
                                    else if (plan.ProductionStatus == "Completed")
                                    {
                                        <span class="badge bg-success">
                                            Completed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @plan.ProductionStatus
                                        </span>
                                    }
                                </td>

                                <td>
                                    <a asp-area="Operations"
                                       asp-controller="Production"
                                       asp-action="Details"
                                       asp-route-id="@plan.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye"></i>
                                        View
                                    </a>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>
</div>