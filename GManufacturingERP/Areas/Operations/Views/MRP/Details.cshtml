@model GManufacturingERP.Models.Entities.MaterialRequirementPlan

@{
    ViewData["Title"] = "MRP Details";
    Layout = "~/Areas/Operations/Views/Shared/_OperationsLayout.cshtml";
}

<div class="page-header">

    <div>
        <small>Operations Manager / Material Planning</small>
        <h1>MRP Details</h1>
        <p>Review required materials for production.</p>
    </div>

    <a asp-area="Operations"
       asp-controller="MRP"
       asp-action="Index"
       class="btn btn-outline-primary">
        <i class="bi bi-arrow-left"></i>
        Back to MRP
    </a>

</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        <i class="bi bi-check-circle-fill"></i>
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle-fill"></i>
        @TempData["ErrorMessage"]
    </div>
}

<div class="row g-4">

    <!-- MRP INFORMATION -->

    <div class="col-lg-8">

        <div class="card dashboard-card">

            <div class="card-header d-flex justify-content-between align-items-center">

                <h5 class="mb-0">
                    <i class="bi bi-box-seam-fill"></i>
                    @Model.MRPNumber
                </h5>

                @if (Model.MRPStatus == "Draft")
                {
                    <span class="badge bg-warning text-dark">
                        Draft
                    </span>
                }
                else if (Model.MRPStatus == "Submitted")
                {
                    <span class="badge bg-info text-dark">
                        Submitted
                    </span>
                }
                else if (Model.MRPStatus == "Approved")
                {
                    <span class="badge bg-success">
                        Approved
                    </span>
                }
                else if (Model.MRPStatus == "Rejected")
                {
                    <span class="badge bg-danger">
                        Rejected
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary">
                        @Model.MRPStatus
                    </span>
                }

            </div>

            <div class="card-body">

                <div class="row g-4">

                    <div class="col-md-6">

                        <label class="details-label">
                            MRP Number
                        </label>

                        <div class="details-value">
                            @Model.MRPNumber
                        </div>

                    </div>

                    <div class="col-md-6">

                        <label class="details-label">
                            Production Plan
                        </label>

                        <div class="details-value">
                            @Model.ProductionPlan?.PlanNumber
                        </div>

                    </div>

                    <div class="col-md-6">

                        <label class="details-label">
                            Buyer Company
                        </label>

                        <div class="details-value">
                            @Model.BuyerCompany
                        </div>

                    </div>

                    <div class="col-md-6">

                        <label class="details-label">
                            Planned Quantity
                        </label>

                        <div class="details-value">
                            @Model.PlannedQuantity Pieces
                        </div>

                    </div>

                    <div class="col-12">

                        <label class="details-label">
                            Product Description
                        </label>

                        <div class="details-value">
                            @Model.ProductDescription
                        </div>

                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Remarks))
                    {
                        <div class="col-12">

                            <label class="details-label">
                                Remarks
                            </label>

                            <div class="details-value">
                                @Model.Remarks
                            </div>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>


    <!-- SUMMARY -->

    <div class="col-lg-4">

        <div class="card dashboard-card">

            <div class="card-header">

                <h5 class="mb-0">
                    <i class="bi bi-calculator"></i>
                    MRP Summary
                </h5>

            </div>

            <div class="card-body">

                <div class="mb-3">

                    <label class="details-label">
                        Total Materials
                    </label>

                    <div class="details-value">
                        @Model.MaterialItems.Count
                    </div>

                </div>

                <div>

                    <label class="details-label">
                        Status
                    </label>

                    <div class="details-value">
                        @Model.MRPStatus
                    </div>

                </div>

                @if (Model.UpdatedAt.HasValue)
                {
                    <div class="mt-3">

                        <label class="details-label">
                            Last Updated
                        </label>

                        <div class="details-value">

                            @(Model.UpdatedAt.Value
                                                    .ToLocalTime()
                                                    .ToString("dd MMM yyyy hh:mm tt"))

                    </div>

                    </div>
                                }

            </div>

        </div>

    </div>

</div>


<!-- REQUIRED MATERIALS -->

<div class="card dashboard-card mt-4">

    <div class="card-header d-flex justify-content-between align-items-center">

        <h5 class="mb-0">

            <i class="bi bi-list-check"></i>
            Required Materials

        </h5>

        @if (Model.MRPStatus == "Draft")
        {
            <a asp-area="Operations"
               asp-controller="MRP"
               asp-action="AddMaterial"
               asp-route-mrpId="@Model.Id"
               class="btn btn-primary btn-sm">

                <i class="bi bi-plus-circle"></i>
                Add Material

            </a>
        }

    </div>

    <div class="card-body">

        @if (!Model.MaterialItems.Any())
        {
            <div class="empty-state">

                <i class="bi bi-box-seam"></i>

                <h5>No Materials Added</h5>

                <p>
                    Add fabric, trims, accessories and packaging materials.
                </p>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table align-middle">

                    <thead>

                        <tr>

                            <th>Material</th>
                            <th>Category</th>
                            <th>Unit</th>
                            <th>Per Piece</th>
                            <th>Wastage</th>
                            <th>Required Quantity</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model.MaterialItems)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @item.MaterialName
                                    </strong>
                                </td>

                                <td>
                                    @item.MaterialCategory
                                </td>

                                <td>
                                    @item.Unit
                                </td>

                                <td>
                                    @item.QuantityPerPiece
                                </td>

                                <td>
                                    @item.WastagePercentage%
                                </td>

                                <td>

                                    <strong>
                                        @item.RequiredQuantity
                                        @item.Unit
                                    </strong>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>


<!-- SUBMIT TO ADMIN -->
@if (Model.MRPStatus == "Draft" &&
     Model.MaterialItems.Any())
{
    <div class="card dashboard-card mt-4">

        <div class="card-body d-flex justify-content-between align-items-center">

            <div>

                <h5 class="mb-1">

                    <i class="bi bi-send"></i>
                    Submit for Admin Approval

                </h5>

                <p class="text-muted mb-0">

                    Once submitted, this MRP cannot be modified
                    until the approval process is completed.

                </p>

            </div>

            <form asp-area="Operations"
                  asp-controller="MRP"
                  asp-action="Submit"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@Model.Id" />

                <button type="submit"
                        class="btn btn-success"
                        onclick="return confirm('Are you sure you want to submit this MRP for Admin approval?');">

                    <i class="bi bi-send-fill"></i>
                    Submit MRP

                </button>

            </form>

        </div>

    </div>
}


<!-- SUBMITTED MESSAGE -->
@if (Model.MRPStatus == "Submitted")
{
    <div class="card dashboard-card mt-4">

        <div class="card-body">

            <div class="d-flex align-items-center">

                <div class="me-3">

                    <i class="bi bi-hourglass-split fs-2 text-info"></i>

                </div>

                <div>

                    <h5 class="mb-1">
                        Waiting for Admin Approval
                    </h5>

                    <p class="text-muted mb-0">

                        This MRP has been submitted successfully
                        and is waiting for Admin review.

                    </p>

                </div>

            </div>

        </div>

    </div>
}


<!-- APPROVED MESSAGE -->
@if (Model.MRPStatus == "Approved")
{
    <div class="card dashboard-card mt-4">

        <div class="card-body">

            <div class="d-flex align-items-center">

                <div class="me-3">

                    <i class="bi bi-check-circle-fill fs-2 text-success"></i>

                </div>

                <div>

                    <h5 class="mb-1">
                        MRP Approved
                    </h5>

                    <p class="text-muted mb-0">

                        This MRP has been approved by Admin
                        and can now be used for Purchase Requisition.

                    </p>

                </div>

            </div>

        </div>

    </div>
}


<!-- REJECTED MESSAGE -->
@if (Model.MRPStatus == "Rejected")
{
    <div class="card dashboard-card mt-4">

        <div class="card-body">

            <div class="d-flex align-items-center">

                <div class="me-3">

                    <i class="bi bi-x-circle-fill fs-2 text-danger"></i>

                </div>

                <div>

                    <h5 class="mb-1">
                        MRP Rejected
                    </h5>

                    <p class="text-muted mb-0">

                        This MRP was rejected during Admin review.

                    </p>

                </div>

            </div>

        </div>

    </div>
}