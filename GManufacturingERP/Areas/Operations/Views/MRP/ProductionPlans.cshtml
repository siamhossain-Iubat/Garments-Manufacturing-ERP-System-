@model IEnumerable<GManufacturingERP.Models.Entities.ProductionPlan>

@{
    ViewData["Title"] = "Production Plans for MRP";
    Layout = "~/Areas/Operations/Views/Shared/_OperationsLayout.cshtml";
}

<div class="page-header">

    <div>
        <small>Operations Manager / MRP</small>
        <h1>Select Production Plan</h1>
        <p>Create material requirements for a production plan.</p>
    </div>

    <a asp-area="Operations"
       asp-controller="MRP"
       asp-action="Index"
       class="btn btn-outline-primary">
        <i class="bi bi-arrow-left"></i>
        Back to MRP
    </a>

</div>

<div class="card dashboard-card">

    <div class="card-header">
        <h5 class="mb-0">
            <i class="bi bi-clipboard2-check"></i>
            Available Production Plans
        </h5>
    </div>

    <div class="card-body">

        @if (!Model.Any())
        {
            <div class="empty-state">

                <i class="bi bi-clipboard2-x"></i>

                <h5>No Production Plans Available</h5>

                <p>
                    Create a production plan first.
                </p>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table align-middle">

                    <thead>
                        <tr>
                            <th>Plan Number</th>
                            <th>Buyer Company</th>
                            <th>Product</th>
                            <th>Quantity</th>
                            <th>Start Date</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var plan in Model)
                        {
                            <tr>

                                <td>
                                    <strong>@plan.PlanNumber</strong>
                                </td>

                                <td>@plan.BuyerCompany</td>

                                <td>@plan.ProductDescription</td>

                                <td>
                                    @plan.PlannedQuantity Pieces
                                </td>

                                <td>
                                    @plan.PlannedStartDate
                                    .ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    <a asp-area="Operations"
                                       asp-controller="MRP"
                                       asp-action="Create"
                                       asp-route-productionPlanId="@plan.Id"
                                       class="btn btn-sm btn-primary">
                                        <i class="bi bi-plus-circle"></i>
                                        Create MRP
                                    </a>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>
</div>