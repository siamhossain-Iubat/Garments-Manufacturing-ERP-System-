@{
    ViewData["Title"] = "Operations Dashboard";
    Layout = "~/Areas/Operations/Views/Shared/_OperationsLayout.cshtml";
}

<div class="page-header">

    <div>
        <small>Operations Manager</small>

        <h1>Dashboard</h1>

        <p>
            Manage production planning and manufacturing activities.
        </p>
    </div>

    <div class="date-box">
        <i class="bi bi-calendar3"></i>
        @DateTime.Now.ToString("dd MMM yyyy")
    </div>

</div>

<div class="row g-4">

    <!-- Approved Orders -->
    <div class="col-lg-3 col-md-6">

        <div class="stat-card">

            <div class="stat-icon blue">
                <i class="bi bi-check2-square"></i>
            </div>

            <div>
                <span>Approved Orders</span>

                <h2>@ViewBag.TotalApprovedOrders</h2>

                <small>Ready for production</small>
            </div>

        </div>

    </div>

    <!-- Production Plans -->
    <div class="col-lg-3 col-md-6">

        <div class="stat-card">

            <div class="stat-icon purple">
                <i class="bi bi-clipboard2-check"></i>
            </div>

            <div>
                <span>Production Plans</span>

                <h2>@ViewBag.TotalProductionPlans</h2>

                <small>Total production plans</small>
            </div>

        </div>

    </div>

    <!-- Active Plans -->
    <div class="col-lg-3 col-md-6">

        <div class="stat-card">

            <div class="stat-icon orange">
                <i class="bi bi-gear-wide-connected"></i>
            </div>

            <div>
                <span>Active Plans</span>

                <h2>@ViewBag.ActiveProductionPlans</h2>

                <small>Currently in progress</small>
            </div>

        </div>

    </div>

    <!-- Completed Plans -->
    <div class="col-lg-3 col-md-6">

        <div class="stat-card">

            <div class="stat-icon green">
                <i class="bi bi-check-circle-fill"></i>
            </div>

            <div>
                <span>Completed Plans</span>

                <h2>@ViewBag.CompletedProductionPlans</h2>

                <small>Completed production plans</small>
            </div>

        </div>

    </div>

</div>

<div class="row g-4 mt-2">

    <!-- Production Planning -->
    <div class="col-lg-6">

        <div class="dashboard-card">

            <div class="card-header">
                <h5 class="mb-0">
                    <i class="bi bi-clipboard2-check-fill"></i>
                    Production Planning
                </h5>
            </div>

            <div class="card-body">

                <h4>Manage Production Plans</h4>

                <p class="text-muted">
                    Create and manage production plans from approved
                    sales orders.
                </p>

                <a asp-area="Operations"
                   asp-controller="Production"
                   asp-action="Index"
                   class="btn btn-primary">
                    <i class="bi bi-clipboard2-check"></i>
                    View Production Plans
                </a>

            </div>

        </div>

    </div>

    <!-- Approved Orders -->
    <div class="col-lg-6">

        <div class="dashboard-card">

            <div class="card-header">
                <h5 class="mb-0">
                    <i class="bi bi-cart-check-fill"></i>
                    Approved Sales Orders
                </h5>
            </div>

            <div class="card-body">

                <h4>Orders Ready for Planning</h4>

                <p class="text-muted">
                    Select approved sales orders and create
                    production plans.
                </p>

                <a asp-area="Operations"
                   asp-controller="Production"
                   asp-action="ApprovedOrders"
                   class="btn btn-outline-primary">
                    <i class="bi bi-check2-square"></i>
                    View Approved Orders
                </a>

            </div>

        </div>

    </div>

</div>