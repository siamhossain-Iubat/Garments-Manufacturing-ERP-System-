@{
    ViewData["Title"] = "Email Confirmed";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Email Confirmed | GManufacturing ERP</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/auth.css"
          asp-append-version="true" />
</head>

<body class="auth-page">

    <div class="auth-wrapper">

        <div class="auth-card text-center">

            <div class="auth-logo mb-4">
                <div class="logo-icon">
                    <i class="bi bi-check-circle-fill"></i>
                </div>

                <h2>GManufacturing ERP</h2>
                <p>Garments Manufacturing Management</p>
            </div>

            <div class="success-icon">
                <i class="bi bi-patch-check-fill"></i>
            </div>

            <h3 class="mt-4">Email Verified Successfully</h3>

            <p class="text-muted mt-3">
                Your email address has been verified successfully.
            </p>

            <div class="alert alert-warning text-start mt-4">
                <strong>Account Status:</strong>
                <br />
                Your account is currently waiting for Admin approval.
                You will be able to log in after approval.
            </div>

            <a asp-controller="Account"
               asp-action="Login"
               class="btn btn-primary w-100 mt-3">
                Go to Login
            </a>

        </div>

    </div>

</body>
</html>