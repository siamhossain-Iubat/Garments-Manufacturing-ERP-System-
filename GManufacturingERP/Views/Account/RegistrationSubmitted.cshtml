@{
    ViewData["Title"] = "Registration Submitted";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Registration Submitted | GManufacturing ERP</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/auth.css"
          asp-append-version="true" />
</head>

<body class="auth-page">

    <div class="auth-wrapper">

        <div class="auth-card text-center">

            <div class="auth-logo mb-4">
                <div class="logo-icon">
                    <i class="bi bi-check2-circle"></i>
                </div>

                <h2>GManufacturing ERP</h2>
                <p>Garments Manufacturing Management</p>
            </div>

            <div class="success-icon">
                <i class="bi bi-envelope-check-fill"></i>
            </div>

            <h3 class="mt-4">Registration Submitted</h3>

            <p class="text-muted mt-3">
                Your buyer account has been created successfully.
                Please verify your email address to continue.
            </p>

            <div class="alert alert-info text-start mt-4">
                <strong>Next Step:</strong>
                <br />
                After email verification, your account will be reviewed
                by the Sales or Admin team.
            </div>

            @if (!string.IsNullOrWhiteSpace(ViewBag.ConfirmationLink))
            {
                <div class="development-link-box text-start mt-4">
                    <small class="text-muted">
                        Development Verification Link
                    </small>

                    <a href="@ViewBag.ConfirmationLink"
                       class="btn btn-primary w-100 mt-2">
                        Verify Email Now
                    </a>
                </div>
            }

            <a asp-controller="Account"
               asp-action="Login"
               class="btn btn-outline-primary w-100 mt-4">
                Back to Login
            </a>

        </div>

    </div>

</body>
</html>